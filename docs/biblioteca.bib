  note = {Editorial de una colección de Frontiers in Psychology sobre pedagogías y metodologías contemporáneas de entrenamiento deportivo. Sin abstract disponible, el análisis se limita al título y a los editores.},
  journal = {Frontiers in Psychology}
}

@misc{anon2026braid,
  title = {{Braid Complexity and Peloton Phase Dynamics}},
  year = {2026},
  url = {https://sportrxiv.org/index.php/server/preprint/view/1164},
  abstract = {Section: Preprints Categories: Sport Science, Statistics, Metascience Keywords: peloton, cycling, braid complexity, phase transitions, collective behavior, Netlogo simulations A peloton is a complex, self-organizing system whose collective behavior is driven largely by energetic coupling, described by the peloton convergence ratio (PCR) and positional ordering, described here as braid complexity (C x *). We formalize peloton phase states by combining PCR with C x *, yielding a coupled energetic-positional index, C x P*. Through time-series segmentation of empirical mass-start data and NetLogo simulations, we develop a phase-space framework comprising compact, stretched, and decoupled states and associated subphases. The inclusion of directional microphases—acceleration (Da) and deceleration (Dd)—reveals a hysteresis-like asymmetry within high-PCR/low-C x * states, indicating a stretched-fatigued (Sf) state as a deceleration-driven counterpart to the standard stretched (S) phase. A multivariate approach provides a useful framework for characterizing self-organized transitions in pelotons and may help inform future study of other self-propelled biological collectives by linking individual physiological limits with group-level structural dynamics.},
  keywords = {sistemas_complejos},
  note = {Preprint que modela las fases de un pelotón con acoplamiento energético y posicional. Aporta ideas trasladables al análisis colectivo en deportes de equipo.},
  howpublished = {SportRxiv}
}

@article{yang2026reconfiguring,
  title = {{Reconfiguring coaching expertise in datafied sport: From knowledge possession to knowledge orchestration}},
  author = {Wooyoung Yang and Seungyup Lim},
  year = {2026},
  doi = {10.1177/17479541261506886},
  url = {https://doi.org/10.1177/17479541261506886},
  abstract = {Although data and digital analytics are increasingly used in sport, their implications for coaching decision-making and expertise remain insufficiently understood. This study examined how data and digital analytics were incorporated into coaching judgement and decision-making and what these processes meant for the reconfiguration of coaching expertise. Semi-structured interviews were conducted with four coaches, three data and analytics specialists, and three athletes with experience in data-informed coaching in elite and professional sport. Data were analysed using reflexive thematic analysis. The findings showed that data did not replace experiential judgement but extended what could be perceived and traced over time, while providing additional grounds on which existing assessments could be reviewed. However, greater access to information did not make coaching decisions self-evident or necessarily more objective. Participants interpreted data's meaning and limitations contextually and selectively weighted diverse forms of evidence. Interpretive work and epistemic authority were distributed among coaches, analysts, and athletes, rendering decision-making more negotiated, whereas authority and accountability for final decisions remained largely with coaches. Taken together, the findings indicated that coaching expertise was being reconfigured around the capacity to orchestrate distributed knowledge, explain, justify, and revise professional judgements, and remain accountable for decisions made under uncertainty. These findings suggest that coach education should extend beyond technical data literacy to develop capacities for contextual interpretation, knowledge orchestration, and accountable professional judgement.},
  keywords = {aprendizaje_talento, futbol},
  note = {Entrevistas a entrenadores, analistas y deportistas muestran que los datos amplían, pero no sustituyen, el juicio del entrenador. La experticia pasa de poseer conocimiento a orquestarlo y justificar las decisiones.},
  journal = {International Journal of Sports Science & Coaching}
}

@article{ding2026goalkeeper,
  title = {{Goalkeeper profiles in the English women's super league: Seasonal trends, team-quality contexts, and implications for coaching practice}},
  author = {Junyuan Ding and Ben Strafford and Alliance Kubayi and Joseph A. Stone},
  year = {2026},
  doi = {10.1177/17479541261506959},
  url = {https://doi.org/10.1177/17479541261506959},
  abstract = {Goalkeeper roles in football are increasingly multidimensional, yet goalkeeper-specific evidence in elite women's football remains limited. This study examined goalkeeper match behaviours in the English Women's Super League across seven available seasons, focusing on seasonal trends and team-quality differences. Hudl StatsBomb event data covered 853 matches, 17 teams, and 71 goalkeepers. Goalkeeper actions were grouped into attacking and defensive domains, standardised using per-match and proportional metrics, and analysed using descriptive statistics, multiple factor analysis, Ward.D2 hierarchical clustering, and regression models appropriate to count and cluster-membership outcomes. Attacking actions accounted for 80.92% of included goalkeeper actions. Cluster analysis identified two dominant profiles, Possession organiser and Goal defender, alongside two rare, event-defined situational subprofiles, Sweeper and Active intervener. The possession organiser profile was dominant, representing 77.7% of team-match observations, while the goal defender profile represented 15.4%. Across seasons, goalkeeper involvement showed a shift towards greater possession involvement, with increases in passing, carrying, ball receipts, and keeper-sweeper actions. Team quality was associated with differences in goalkeeper profiles: Top 4 teams showed greater possession involvement and more possession organiser profiles, whereas Low-ranking teams showed greater defensive workload and more goal defender profiles. These findings support a layered approach to goalkeeper profiling, in which broad possession- and defence-oriented involvement is interpreted alongside rare but tactically meaningful situational actions.},
  keywords = {futbol},
  note = {Análisis de 853 partidos de la WSL que identifica un perfil dominante de portera organizadora de posesión y una tendencia creciente hacia la implicación con balón. La calidad del equipo se asocia al perfil.},
  journal = {International Journal of Sports Science & Coaching}
}

@article{cardona2026playing,
  title = {{Playing up the ladder: GPS-derived match physical outputs of youth soccer players promoted to a higher age category}},
  author = {Sergio Cardona and Ángel García-Fernández and Julen Castellano},
  year = {2026},
  doi = {10.1177/17479541261507249},
  url = {https://doi.org/10.1177/17479541261507249},
  abstract = {This study examined the GPS-derived match physical outputs of youth soccer players promoted to compete in a higher age category. A retrospective observational study was conducted using match data collected over three seasons (2022–23 to 2024–25) from an elite youth soccer academy (n = 221). Three questions were examined: (i) whether promoted players differed from their regular teammates when competing in their original age category; (ii) whether they differed from the regular players of the higher age category when competing alongside them; and (iii) whether the same promoted players changed their physical outputs between the two age categories. External load variables included relative total distance, high-speed running, sprint distance, high intensity accelerations and decelerations. In their original age category, promoted players did not consistently differ from their regular teammates, although promoted Under-19 midfielders covered greater high-speed running distance. In the higher age category, promoted players generally showed physical outputs similar to those of the regular players of that category, although promoted Under-19 wingers covered greater sprint distance than regular Under-23 wingers. Within-player comparisons, often based on very few players, revealed position- and category-specific changes, with significant effects for decelerations in Under-16 and Under-19 centre-backs, high-speed running and sprint distance in Under-17 full-backs and strikers, and total distance in Under-19 strikers. These findings suggest that promotion is not associated with a consistent change in match physical outputs, but rather with specific changes according to age category, playing position, and physical variable, supporting individualized approaches to player development.},
  keywords = {futbol, aprendizaje_talento},
  note = {Estudio con GPS en 221 jóvenes de una academia que no halla un patrón físico común en los promovidos. Los cambios dependen de la posición y la categoría.},
  journal = {International Journal of Sports Science & Coaching}
}

@article{steenbok2026analysis,
  title = {{Analysis of attacking and defensive playing styles in the Africa cup of nations under-17 and under-20 soccer tournaments}},
  author = {Walter Steenbok and Alliance Kubayi and Junyuan Ding and Joseph A Stone},
  year = {2026},
  doi = {10.1177/17479541261507315},
  url = {https://doi.org/10.1177/17479541261507315},
  abstract = {Identifying and quantifying the different playing styles used by African youth soccer teams is important for objectively describing tactical approaches and team behaviours. This study aimed to identify and analyse team-match playing-style profiles during the Africa Cup of Nations (AFCON) Under-17 (U17) and Under-20 (U20) soccer tournaments. The AFCON U17 sample included 68 team-match observations from 34 matches, and the AFCON U20 sample included 60 team-match observations from 30 matches. Data were obtained from the Wyscout platform. Data were analysed using descriptive statistics, multiple factor analysis, Ward.D2 hierarchical clustering, and outcome-appropriate regression models with standard errors clustered by team and match. The pooled analysis identified four team-match profiles: (1) limited progression, (2) controlled possession and progression, (3) balanced counterattacking, and (4) direct high-transition duel. Pooled Clusters 2 and 3 had higher estimated goal rates than Clusters 1 and 4 after adjustment for multiple comparisons, and U20 teams had a lower estimated goal rate than U17 teams. No pairwise differences in winning odds between clusters remained significant after adjustment, and no robust association was identified between cluster membership and goals conceded. The findings, therefore, provide stronger evidence for an association with goals scored than with match outcome.},
  keywords = {futbol},
  note = {Cuatro perfiles de juego en torneos africanos sub-17 y sub-20, con mejor asociación a los goles que al resultado.},
  journal = {International Journal of Sports Science & Coaching}
}

@article{cular2026talent,
  title = {{Talent or timing? Skeletal maturity, biological maturation, and the relative age effect in youth athletes: a cross-sectional study from a high-performance sporting environment}},
  author = {Dražen Čular and Dino Belošević and Ana Kezić and Marijana Čavala and Vladimir Ivančev and Wissem Dhahbi and Karim Chamari},
  year = {2026},
  doi = {10.3389/fspor.2026.1979741},
  url = {https://doi.org/10.3389/fspor.2026.1979741},
  abstract = {Aim We characterised the skeletal maturity profile, relative age distribution, and sport-type differences in biological maturation within a cohort of selected youth athletes from a high-performance sport environment. Methods Thirty-seven youth athletes (20 male, 17 female; mean chronological age: 14.92 ± 1.81 years) from 21 clubs across 15 sports in Split, Croatia, were assessed during the 2024–2025 competitive season. Skeletal age (SA) was estimated using the validated BAUSport™ SonicBone ultrasound system and compared with chronological age (CA). Athletes were classified as early (SA-CA ≥ + 1.0 year), on-time, or late maturers. Sports were assigned a priori to physical/power-dominant or skill/technical-aesthetic categories. The Relative Age Effect (RAE) was examined via chi-square goodness-of-fit and pairwise odds ratios; the primary sport-type contrast used the Mann–Whitney U test with rank-biserial r as the effect size index. Results Mean SA exceeded CA by 0.77 ± 0.89 years across the cohort, with 29.7% classified as early maturers and only 2.7% as late maturers. A marginal, preliminary RAE was observed ( χ 2 (3) = 8.08, p = 0.044, Cramér's V = 0.27), driven by Q1 overrepresentation (43%) rather than Q4 underrepresentation (24%); only Q1 versus Q3 was nominally significant (OR=4.00, 95% CI [1.34, 11.96]), not surviving Holm correction. The sport-type contrast was large and significant: SA-CA was +1.14 ± 0.81 years in physical/power-dominant sports versus +0.16 ± 0.67 years in skill/technical-aesthetic sports (U = 274.0, p = 0.00043, r = −0.70; Hedges’ g = 1.26, 95% CI [0.55, 1.97]). All 11 early maturers belonged to the physical/power-dominant group. The contrast persisted after adjustment for chronological age, sex, selection tier, and sport-level aggregation, in a},
  keywords = {aprendizaje_talento},
  note = {En 37 atletas jóvenes de élite, la maduración esquelética se adelanta sobre todo en deportes de potencia, con efecto de edad relativa marginal.},
  journal = {Frontiers in Sports and Active Living}
}

@article{wang2026auditory,
  title = {{Auditory deprivation impairs badminton players’ stroke and anticipatory performance: a field experimental study}},
  author = {Xiaoting Wang and Bin Zhang and Pengfei Ren and Ruiyuan Li},
  year = {2026},
  doi = {10.3389/fpsyg.2026.1958855},
  url = {https://doi.org/10.3389/fpsyg.2026.1958855},
  abstract = {Background Accurate anticipation and precise motor execution are critical to success in badminton, yet most previous research has focused on visual information, with limited evidence regarding the role of auditory information. The present study used a two-part field design to investigate the effects of auditory information on stroke performance and anticipatory performance in badminton. Methods Thirty skilled badminton players completed both parts of the study in a fixed sequence. Part A employed a within-subjects design to examine the effects of modality type (audiovisual condition vs. visual-only condition) on reaction time and hitting accuracy in a smash-return task under the predictable-shot context (shot depth and direction known in advance). Part B employed the same participants and experimental design, with the addition of eye-tracking technology, to examine the effects of modality type on reaction time, mean fixation duration, and saccade frequency under an anticipatory condition (shot depth and direction unknown). Results In Part A, auditory deprivation significantly reduced stroke scores ( p &lt; 0.001) and increased failure rates ( p &lt; 0.001), but did not affect reaction time ( p = 0.376). In Part B, auditory deprivation prolonged reaction time ( p &lt; 0.001) and shortened mean fixation duration ( p = 0.009), while saccade frequency showed no significant difference ( p = 0.862). Conclusion Auditory deprivation led to declines in both stroke accuracy and anticipatory efficiency in badminton players, indicating that auditory information may play a significant role in athletes’ motor control and perceptual processing. Based on these findings, it is recommended that training programs intentionally incorporate multisensory (particularly auditory) cues into tec},
  keywords = {aprendizaje_talento},
  note = {La falta de audio empeora la precisión y la anticipación en bádminton, lo que sugiere incluir señales multisensoriales en el entrenamiento.},
  journal = {Frontiers in Psychology}
}

@article{zhang2026explainable,
  title = {{Explainable machine learning audit of attribute rating relationships in Football Manager 2023}},
  author = {Zijian Zhang and Zhuyue Zhang and Lin Qiu},
  year = {2026},
  doi = {10.1371/journal.pone.0363141},
  url = {https://doi.org/10.1371/journal.pone.0363141},
  abstract = {Background Football Manager data contain simulated player attributes generated within a proprietary game environment. They can reveal relationships within the rating system but cannot establish real-world talent-identification validity. Objective To audit how baseline attributes predict an internal Football Manager 2023 (FM2023) rating threshold, compare four untuned models under repeated cross-validation, and examine model-specific attribute-contribution stability across categories and positions. Methods We analyzed 2,282 anonymized male player profiles aged 15–18 years. The outcome was an FM2023 overall score of at least 10. Logistic regression, random forest, radial support vector machine (SVM), and a single-hidden-layer neural network were evaluated with three repeats of stratified five-fold cross-validation. We report receiver operating characteristic area under the curve (ROC-AUC), precision-recall AUC (PR-AUC; average precision), F1 score, sensitivity, specificity, balanced accuracy, Matthews correlation coefficient (MCC), and Brier score. Logistic-regression contributions were calculated on the logit scale; position-specific top-five stability was evaluated with 1,000 bootstrap samples per modeled position. Results Logistic regression had the highest mean ROC-AUC (0.779 ± 0.033) and PR-AUC (0.380 ± 0.047), whereas the neural network had the highest mean F1 score (0.284 ± 0.055). At the prespecified 0.50 threshold, logistic-regression sensitivity was 0.132 and specificity was 0.983. Technical, physical, and mental attributes appeared among the ten highest-ranked contributions. Mean absolute contribution per feature was slightly lower for technical than physical attributes (difference −0.0043). Position-specific rankings differed, but several top-five features had},
  keywords = {futbol, aprendizaje_talento},
  note = {Auditoría con aprendizaje automático de los atributos de Football Manager 2023; útil como cautela, no como evidencia de talento real.},
  journal = {PLOS ONE}
}

