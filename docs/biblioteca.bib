@article{temel2026metabolic,
  title = {{Metabolic, Endocrine, and Neurotrophic Responses to a 4v4 Small-Sided Game Following Brief Music or Mindfulness After a Mental-Fatigue Exposure: A Randomized Crossover Trial.}},
  author = {Nisanur Canikli Temel and Mustafa Temel and İlimdar Yalçın and Fatma Yaşar and Göktürk Samet Kılıç and Burcu Kılıç and Sinan Demirci and Mehmet Bayansalduz},
  year = {2026},
  doi = {10.3390/metabo16110823},
  url = {https://pubmed.ncbi.nlm.nih.gov/43090360/},
  abstract = {Background/Objectives: Prolonged cognitive load, including short-form social-media use, may influence soccer-specific performance, yet the perceptual, metabolic, endocrine and neurotrophic effects of brief post-fatigue strategies such as music and mindfulness remain unclear. This study compared 15 min music, 15 min mindfulness (body scan) and time-matched control after a 45 min short-form social-media mental-fatigue exposure. Methods: Sixteen trained male soccer players completed a randomized, counterbalanced, repeated-measures crossover trial. Each session comprised the exposure, condition, a standardized warm-up and a 4v4 small-sided game (SSG). Venous blood was obtained pre-protocol (T1) and approximately 5 min post-SSG (T2) for serum lactate, cortisol and brain-derived neurotrophic factor (BDNF). Perceptual and technical-performance outcomes were also analysed using linear mixed-effects models. Results: Post-condition mental-effort scores differed by condition (F(2,30) = 12.117, p < 0.001) and were lower in music and mindfulness than in control in a time-point-specific model, although baseline mental effort also differed between conditions; perceived mental fatigue, post-SSG exertion and enjoyment did not differ. Condition effects emerged for successful passes (p = 0.020), ball recoveries (p = 0.010) and ball losses (p = 0.018), all highest during mindfulness; pass success percentage, shot outcomes and net ball recovery were unchanged. Overall lactate (p = 0.013) and cortisol (p = 0.047) differed between selected conditions when averaged across sampling times, possibly reflecting pre-existing differences, but BDNF did not differ (p = 0.559), and no time effects or condition × time interactions were observed. Conclusions: In this sample of 16 trained male Tier 2 play},
  keywords = {futbol},
  note = {Cruzado aleatorizado en 16 futbolistas: tras 45 min de redes sociales, música o mindfulness 15 min antes de un 4v4; hubo más pases acertados y recuperaciones tras mindfulness, sin cambios en BDNF.},
  journal = {Metabolites}
}

@article{tan2026evaluating,
  title = {{Evaluating Passing Performance in Youth Football: A Systematic Review Toward an Ecological Dynamics Framework}},
  author = {Xiangbo Tan and Zhixin Feng and Tingyu Zhang and Wenxiao Deng and Zhiliang Dong and Qing Yi},
  year = {2026},
  doi = {10.52082/jssm.2026.1021},
  url = {https://doi.org/10.52082/jssm.2026.1021},
  abstract = {Passing is a fundamental component of football performance, yet current approaches to evaluating passing performance in youth football remain methodologically diverse and conceptually fragmented. This systematic review aimed to map and critically evaluate existing approaches to evaluating passing performance in youth football, focusing on evaluation dimensions, indicators, tools, scenarios, and the extent to which individual, task, and environmental constraints are reported or incorporated. The review also aimed to synthesize the evidence toward a conceptual micro-meso-macro framework for representative passing evaluation. A systematic search of PubMed, Web of Science Core Collection, and Scopus was conducted for peer-reviewed studies published between January 2000 and September 2025 involving youth association football players aged 19 years or younger and reporting passing-related outcomes. Studies were selected according to predefined eligibility criteria and reported in accordance with the PRISMA 2020 guidelines. Methodological and reporting quality was assessed using a 16-item checklist, and included studies were coded using an individual-task-environment constraint framework. The review protocol was registered in the Open Science Framework before database searching, screening, data extraction, ecological coding, and synthesis (OSF registration ID: 2bqfy). Thirty-six studies were included. The reviewed approaches were organized into three analytical dimensions: individual technical ability, contextual decision-making ability, and passing team contribution. Contextual decision-making represented the largest group of studies, whereas team contribution approaches were less frequently represented. The evidence map suggested an overall imbalance toward controlled and sta},
  keywords = {pedagogia_no_lineal, futbol, aprendizaje_talento},
  note = {Revisión de 36 estudios que muestra que la evaluación del pase juvenil prioriza tests controlados frente a contextos representativos. Propone un marco micro-meso-macro para evaluar el pase con restricciones ecológicas. Es una síntesis conceptual, aún sin validar.},
  journal = {Journal of Sports Science and Medicine}
}

@article{martinbarrero2026impacto,
  title = {{Impacto de la metodología no lineal sobre variables técnicas y cinemáticas en el entrenamiento de fútbol}},
  author = {Alberto Martín-Barrero and Francisco Ignacio Martínez-Cabrera and Dima Marius-Dumitru},
  year = {2026},
  doi = {10.58727/jshr.116700},
  url = {https://doi.org/10.58727/jshr.116700},
  keywords = {pedagogia_no_lineal, futbol, aprendizaje_talento},
  note = {Compara dos tareas de 8 min en 22 jugadores semiprofesionales: la no lineal duplica participación y distancia, pero genera menos pases totales que la analítica. La conclusión de los autores es más favorable que sus tablas.},
  journal = {Journal of Sport and Health Research}
}

