@article{ric2017dynamics,
  title = {{Dynamics of tactical behaviour in association football when manipulating players' space of interaction}},
  author = {Ángel Ric and Carlota Torrents and Bruno V. Gonçalves and Lorena Torres-Ronda and Jaime E. Sampaio and Robert Hristovski},
  year = {2017},
  doi = {10.1371/journal.pone.0180773},
  url = {https://doi.org/10.1371/journal.pone.0180773},
  abstract = {The analysis of positional data in association football allows the spatial distribution of players during matches to be described in order to improve the understanding of tactical-related constraints on the behavioural dynamics of players. The aim of this study was to identify how players' spatial restrictions affected the exploratory tactical behaviour and constrained the perceptual-motor workspace of players in possession of the ball, as well as inter-player passing interactions. Nineteen professional outfield male players were divided into two teams of 10 and 9 players, respectively. The game was played under three spatial constraints: a) players were not allowed to move out of their allocated zones, except for the player in possession of the ball; b) players were allowed to move to an adjacent zone, and; c) non-specific spatial constraints. Positional data was captured using a 5 Hz interpolated GPS tracking system and used to define the configuration states of players for each second in time. The configuration state comprised 37 categories derived from tactical actions, distance from the nearest opponent, distance from the target and movement speed. Notational analysis of players in possession of the ball allowed the mean time of ball possession and the probabilities of passing the ball between players to be calculated. The results revealed that the players' long-term exploratory behaviour decreased and their short-term exploration increased when restricting their space of interaction. Relaxing players' positional constraints seemed to increase the speed of ball flow dynamics. Allowing players to move to an adjacent sub-area increased the probabilities of interaction with the full-back during play build-up. The instability of the coordinative state defined by being },
  keywords = {pedagogia_no_lineal, sistemas_complejos, futbol},
  note = {Tres condiciones de restricción espacial en jugadores profesionales muestran cambios en la exploración táctica y en los patrones de pase. Referencia muy citada (97 citas).},
  journal = {PLoS ONE}
}

@article{welch2021collective,
  title = {{Collective states and their transitions in football}},
  author = {Mitchell Welch and Timothy M. Schaerf and Aron J. Murphy},
  year = {2021},
  doi = {10.1371/journal.pone.0251970},
  url = {https://doi.org/10.1371/journal.pone.0251970},
  abstract = {Movement, positioning and coordination of player formations is a key aspect for the performance of teams within field-based sports. The increased availability of player tracking data has given rise to numerous studies that focus on the relationship between simple descriptive statistics surrounding team formation and performance. While these existing approaches have provided a high-level a view of team-based spatial formations, there is limited research on the nature of collective movement across players within teams and the establishment of stable collective states within game play. This study draws inspiration from the analysis of collective movement in nature, such as that observed within schools of fish and flocking birds, to explore the existence of collective states within the phases of play in soccer. Order parameters and metrics describing group motion and shape are derived from player movement tracks to uncover the nature of the team's collective states and transitions. This represents a unique addition to the current body of work around the analysis of player movement in team sports. The results from this study demonstrate that sequences of ordered collective behaviours exist with relatively rapid transitions between highly aligned polar and un-ordered swarm behaviours (and vice-versa). Defensive phases of play have a higher proportion of ordered team movement than attacking phases, indicating that movements linked with attacking tactics, such as player dispersion to generate passing and shooting opportunities leads to lower overall collective order. Exploration within this study suggests that defensive tactics, such as reducing the depth or width to close passing opportunities, allows for higher team movement speeds and increased levels of collective order. Th},
  keywords = {sistemas_complejos, futbol},
  note = {Muestra que los equipos pasan rápido entre estados colectivos ordenados y desordenados, con más orden en defensa que en ataque.},
  journal = {PLoS ONE}
}

@article{boncut2026group,
  title = {{Group Cohesion and Salivary Oxytocin During a Six-Month Coordination-Based Training Program in Junior Handball Players: A Prospective Non-Randomized Controlled Intervention Study.}},
  author = {Mircea Boncuț and Sorin Simon and Mircea Nicolae Ordean and Vlad Teodor Grosu and Siria Mancini and Horatiu Dacian Ghejan and Fiorenzo Moscatelli and Emilia Florina Grosu and Nicola Mancini},
  year = {2026},
  doi = {10.3390/sports14110498},
  url = {https://pubmed.ncbi.nlm.nih.gov/43083366/},
  abstract = {Whether coordination-based training can develop group cohesion in youth sport, and how cohesion relates to peripheral oxytocin, is unclear. We examined cohesion and salivary oxytocin during a six-month coordination- and cohesion-oriented program in junior handball players. Sixty-four male players (12-14 years) from four clubs joined a prospective, non-randomized, within-club controlled study (not prospectively registered). In each club, one pre-existing training slot (eight players) formed the experimental group (EG; n = 32) and the other the control group (CG; n = 32). For 24 weeks (three sessions/week), EG replaced 20-25 min of technical-tactical work with coordination, cooperation, and interpersonal-synchrony exercises. The primary outcome was Youth Sport Environment Questionnaire (YSEQ) Task Cohesion. In the baseline-adjusted, cluster-robust analysis, T1 Task Cohesion was 0.72 points higher in EG than CG (95% CI 0.22-1.23; p = 0.010); Social Cohesion differed similarly (adjusted difference 0.77 points; 95% CI 0.33-1.22; p = 0.003). The adjusted oxytocin difference was imprecise and non-significant (5.0 pg/mL; 95% CI -0.01 to 10.02; p = 0.050), and oxytocin change was unrelated to Task Cohesion change. The program was accompanied by a more favorable cohesion trajectory than time-matched standard training. Non-randomized allocation precludes causal conclusions; oxytocin findings remain exploratory.},
  keywords = {aprendizaje_talento, sistemas_complejos},
  note = {Seis meses de tareas de coordinación y sincronía se asociaron a mayor cohesión de tarea y social en balonmano juvenil. No es causal y la oxitocina no mostró relación.},
  journal = {Sports (Basel, Switzerland)}
}

@article{mora2026can,
  title = {{Can Standardized Small-Sided Games Be Used as a Tool to Monitor Post-Match Fatigue in Male Academy Soccer Players?}},
  author = {Javier Hidalgo-de Mora and Moisés de Hoyo Lora and Miguel Ángel Campos-Vázquez and Filipe Maia and Manuel Lapuente-Sagarra and Fernando Pareja-Blanco},
  year = {2026},
  doi = {10.3390/sports14110487},
  url = {https://pubmed.ncbi.nlm.nih.gov/43083353/},
  abstract = {This study aimed to analyze residual post-match fatigue using time-motion analysis across small-sided games (SSGs), fitness performance, and heart rate variability (HRV) in academy soccer players. Fifteen male academy players (18.3 ± 0.6 years) performed four SSG formats: 3 vs. 3 and 3 vs. 3 + 2 goalkeepers, played on small (25 × 18 m; 75 m2 per player) and large (36 × 25 m; 150 m2 per player) areas in a four-week experimental design. Two non-match weeks served as baseline weeks, and two weeks followed an official match. Time-motion during SSGs was monitored via GNSS. Before each training session (24, 72, and 120 h post-match), HRV, countermovement jump (CMJ) height, and maximum isometric force (MIF) of the hamstrings were measured. External load metrics were generally lower in post-match sessions than in non-match weeks; however, their low reliability limited the interpretability of SSG outputs. CMJ height was reduced, MIF was elevated post-match, whereas HRV showed distinct mid-week responses, decreasing in starters but increasing in non-starters. Post-match fatigue was evident in neuromuscular performance but was inconsistently reflected in SSG outputs. CMJ height reliably reflects post-match fatigue in male academy soccer players and should be prioritized when monitoring neuromuscular recovery.},
  keywords = {futbol},
  note = {Los juegos reducidos 3v3 no reflejaron bien la fatiga postpartido, mientras el CMJ sí.},
  journal = {Sports (Basel, Switzerland)}
}

@article{vasquezbonilla2026neuromuscular,
  title = {{Neuromuscular Performance Thresholds to Support Player Development in a Professional Soccer Academy.}},
  author = {Aldo A Vasquez-Bonilla and Jesús De Jorge López and Daniel Rojas-Valverde},
  year = {2026},
  doi = {10.3390/sports14110522},
  url = {https://pubmed.ncbi.nlm.nih.gov/43083390/},
  abstract = {We aimed to compare neuromuscular performance between academy soccer players (U-17, U-19, and U-21 categories) and first-team players, and to establish neuromuscular performance thresholds associated with the first-team level. Ninety-four male players participated and were followed over two seasons. Neuromuscular performance was assessed using force-plate and force-sensing frame technologies, including isometric hip adduction and abduction, Nordic hamstring exercise, countermovement jump (CMJ), and isometric squat hold. Peak force, eccentric and concentric peak force, rate of force development, impulse, modified reactive strength index (RSI-modified), dynamic strength index (DSI) and limb asymmetry were analyzed. Linear mixed models, binary logistic generalized estimating equations (GEE), and receiver operating characteristic (ROC) curve analyses were performed. The neuromuscular variables that best discriminated between soccer academy and first-team were maximal hip pull force (OR = 2.53, p < 0.001), concentric peak force (OR = 2.42, p < 0.001), eccentric peak force (OR = 1.31, p = 0.046), modified RSI (OR = 2.00, p < 0.001), RFD at 200 ms (OR = 1.46, p = 0.004), and DSI (OR = 2.13, p < 0.001). ROC analysis identified practical cutoff values for maximal hip abduction force (442 N), maximal concentric and eccentric forces during the CMJ (1856 and 1804 N, respectively), modified RSI (0.58 m·s-1) and DSI (0.57). First-team players demonstrate superior neuromuscular performance to academy players. The identified cutoff values should be considered exploratory benchmarks for distinguishing current competitive levels and require external, prospective validation in independent cohorts from other clubs before practical application.},
  keywords = {aprendizaje_talento, futbol},
  note = {Umbrales neuromusculares que separan cantera y primer equipo en 94 jugadores; exploratorios y de un solo club.},
  journal = {Sports (Basel, Switzerland)}
}

@article{casamichana2026to,
  title = {{To Ensure Peak Velocity in Soccer, Coaches Should Stimulate Players to Run.}},
  author = {David Casamichana and Eider Barba and Andres Martín-García and Fábio Yuzo Nakamura and Julen Castellano},
  year = {2026},
  doi = {10.5114/jhk/208288},
  url = {https://pubmed.ncbi.nlm.nih.gov/43081119/},
  abstract = {The aim of this study was to compare the peak velocities reached by professional soccer players during multiple training tasks and friendly matches, taking into account players' positions. Global positioning system data were obtained from twenty-three soccer players (age: 24.8 ± 4.1 years; body height: 180.3 ± 6.3 cm; body mass: 75.7 ± 5.0 kg) who played for the same professional first division team of the Spanish league (La Liga). The peak of velocity (km•h-1) of ten different training tasks was analyzed according to the players' position. The results showed that there were significant differences (p tactical velocity task (TVE, n = 53), friendly match (FM, n = 231) > large-sided game (LSG, n = 146) > medium-sided game (MSG, n = 273) > evolution task (EVO, n = 381), high interval intensity training (HIIT, n = 227), small-sided game (SSG, n = 407) > large-sided ball-possession game (LSBPG, n = 227) > small-sided ball-possession game (SSBPG, n = 316) and, 2) that in the tasks with lower peak velocities (MSG, EVO, HIIT, SSG, LSBPG and SSBPG), no differences were found in their positions. Therefore, different training tasks create different peak velocity demands, and tasks with higher peak velocities and role-specificity (TVE, FM, LSG, and MSG) require different needs from players in different positions.},
  keywords = {futbol},
  note = {Los juegos reducidos generan menos velocidad pico que los amistosos y los juegos grandes.},
  journal = {Journal of human kinetics}
}

@article{fan2026a,
  title = {{A transformer-based multimodal fusion framework for ordinal motor skill-level assessment with biomechanical association analysis}},
  author = {Lei Fan and Keji Yan and Junmian Wang},
  year = {2026},
  doi = {10.3389/fpsyg.2026.1895821},
  url = {https://doi.org/10.3389/fpsyg.2026.1895821},
  abstract = {Accurate motor skill assessment is essential for objective sports performance evaluation and data-driven coaching support. However, existing approaches often rely on single sensors, conventional classification models, or limited biomechanical interpretation, restricting their ability to capture comprehensive movement characteristics and ordered skill relationships. To address these limitations, this study proposes BioSkillFormer, a Transformer-based multimodal fusion framework for classifying badminton players into beginner, intermediate, and expert skill levels. The proposed framework integrates raw multimodal sensor sequences, timefrequency representations, biomechanical feature tokens, and reliability-aware cross-modal attention to capture complementary information from pose, electromyography (EMG), foot pressure, eye gaze, and video data. Skill-level prediction is formulated as an ordinal classification problem to preserve the natural progression of motor expertise. The framework was evaluated using the MultiSenseBadminton dataset under a subject-independent evaluation protocol. Experimental results demonstrated that BioSkillFormer achieved an accuracy of 0.8495, macro-F1 of 0.8375, balanced accuracy of 0.8420, ordinal mean absolute error (MAE) of 0.1560, and quadratic weighted kappa of 0.8530, outperforming single-sensor, timefrequency Transformer, and standard multimodal Transformer comparative methods. Ablation experiments indicated that ordinal loss, biomechanical tokens, timefrequency modeling, reliability-aware fusion, supervised contrastive learning, and masked modality reconstruction contributed to the observed performance. Furthermore, biomechanical association analysis revealed significant associations between predicted skill levels and movement-quality in},
  keywords = {aprendizaje_talento},
  note = {Marco Transformer multimodal que clasifica jugadores de bádminton en tres niveles con precisión de 0,85; interesa solo como evaluación de la habilidad motriz.},
  journal = {Frontiers in Psychology}
}

@article{mendes2026gender,
  title = {{Gender Differences in Pre-Service Physical Education Teachers' Visual Behaviour: An Eye-Tracking Study.}},
  author = {Rodrigo Mendes and Paulo Nobre and Gonçalo Dias},
  year = {2026},
  doi = {10.3390/jemr19060131},
  url = {https://pubmed.ncbi.nlm.nih.gov/43081587/},
  abstract = {(1) Background: Teachers' visual attention is central to professional vision, yet whether teacher gender influences gaze allocation in Physical Education remains unclear. This study examined gender-related differences in visual attentional deployment when teachers observed students' motor competence, behavioural engagement, off-task behaviour, and gender. (2) Methods: Sixty pre-service Physical Education teachers observed video-recorded tasks from a class while wearing Tobii Pro Glasses 3. Fixation metrics were quantified across predefined areas of interest and compared between teacher genders. (3) Results: Female and male teachers showed comparable total and mean fixation durations. However, the former produced significantly more fixations during the closed task towards on-task students and with higher motor competence. Female teachers also showed higher fixation frequency regardless of whether off-task behaviour was successfully identified, and made more fixations towards both female and male students during this task. These differences were not consistently observed during the open task. (4) Conclusions: Teacher gender differed primarily with fixation frequency rather than fixation duration, and this effect was context-dependent. Additionally, greater visual sampling did not necessarily correspond to more accurate behavioural noticing. Mobile eye-tracking can reveal gender-related and task-sensitive differences in teachers' visual behaviour, with potential applications in Physical Education teacher education and professional development.},
  keywords = {aprendizaje_talento},
  note = {Eye-tracking en 60 docentes de EF en formación: las mujeres hicieron más fijaciones en la tarea cerrada, sin diferencias de duración.},
  journal = {Journal of eye movement research}
}

@article{pojskic2026shooting,
  title = {{Shooting accuracy and conditioning characteristics in proficient and non-proficient male perimeter basketball players: effects of distance and condition.}},
  author = {Haris Pojskic and Dimitrije Cabarkapa and Jinshu Zeng and Wael Daab and Nenad Trunic and Damjana V Cabarkapa and Damir Sekulic},
  year = {2026},
  doi = {10.3389/fspor.2026.1929659},
  url = {https://pubmed.ncbi.nlm.nih.gov/43080325/},
  abstract = {Shooting accuracy is a key performance indicator in basketball, highlighting the importance of understanding how it varies with playing proficiency across different shooting conditions and distances. The present study had a three-fold aim to examine: i) the effects of shooting distance and condition complexity on shooting accuracy with respect to playing proficiency, ii) differences in shooting accuracy betwee playing proficient (PP) and non-proficient (NP) basketball perimeter players across different distances and conditions, and iii) differences in conditioning characteristics between PP and NP. The sample included 14 PP (age: 23.8 ± 3.4 years; body height: 189.4 ± 5.3 cm; body mass: 85.8 ± 5.6 kg) and 14 NP (age: 20.2 ± 2.0 years; body height: 182.7 ± 6.3 cm; body mass: 74.0 ± 10.2 kg) perimeter players. Three shooting conditions were assessed: stationary, dynamic, and competitive, across three distances (free-throw, two-point, and three-point). Conditioning characteristics were evaluated using a comprehensive battery of tests encompassing lower- and upper-body power, aerobic fitness, sprinting speed, change-of-direction speed, anaerobic capacity, and fatigue resistance. A binomial generalized linear mixed model examined all main effects and interactions. Independent-samples t-tests with Holm correction assessed differences in conditioning characteristics, quantified using Hedges' g. Even though PP showed greater overall shooting accuracy (p = .041), playing proficiency did not significantly moderate the effects of shooting condition or distance (all p ≥ .431). Accuracy declined with increasing distance and condition complexity (both p < .001), with a condition×distance interaction (p = .024). Competitive accuracy was lower than dynamic accuracy at two- and three-po},
  keywords = {aprendizaje_talento},
  note = {Precisión de tiro en baloncesto en 14 jugadores competentes y 14 no competentes según distancia y condición; incluye pruebas de condición física.},
  journal = {Frontiers in sports and active living}
}

@article{hui2026reciprocal,
  title = {{Reciprocal within-person associations between physical activity self-efficacy and enjoyment among primary school students participating in a cooperative games-based physical education curriculum: a four-wave random-intercept cross-lagged panel study}},
  author = {Beifang Hui and Yingcheng Wu},
  year = {2026},
  doi = {10.3389/fpsyg.2026.1922812},
  url = {https://doi.org/10.3389/fpsyg.2026.1922812},
  abstract = {Introduction Physical activity self-efficacy and enjoyment are central to children’s motivation to be active, yet their temporal ordering and within-person interplay remain unclear. This study examined their reciprocal associations among 1,279 Chinese students in Grades 5 and 6 participating in a cooperative games-based physical education curriculum. Methods General physical activity self-efficacy and enjoyment were assessed on four occasions separated by 33, 28, and 28 days. Longitudinal measurement invariance was tested before conventional cross-lagged panel models and random-intercept cross-lagged panel models (RI-CLPMs) were compared. The primary RI-CLPM used class-clustered robust maximum likelihood and full information maximum likelihood for missing data. Results Scalar invariance was supported for both measures, and temporal equality constraints were not rejected. At the between-person level, average self-efficacy and enjoyment were positively correlated, r = 0.672, p &lt; 0.001. In the retained equal-lag model, higher-than-usual self-efficacy predicted subsequent higher-than-usual enjoyment, b = 0.147, 95% CI [0.096, 0.198], βs = 0.146–0.154, p &lt; 0.001. Higher-than-usual enjoyment also predicted subsequent self-efficacy, b = 0.088, 95% CI [0.026, 0.150], βs = 0.083–0.084, p = 0.005. The directional contrast was not significant, p = 0.063. Both associations remained positive in the corresponding complete-case model (n = 1,025), after class-by-wave mean adjustment, and under the specified missing-data sensitivity scenarios. Discussion The findings support reciprocal within-person temporal associations between general physical activity self-efficacy and enjoyment. They provide a basis for studying cognitive and affective motivation jointly in children participat},
  keywords = {aprendizaje_talento},
  note = {1279 escolares chinos con un currículo de juegos cooperativos: la autoeficacia predijo el disfrute posterior (b = 0,147) y viceversa (b = 0,088).},
  journal = {Frontiers in Psychology}
}

@article{palmer2023cooperative,
  title = {{Cooperative networks in team invasion games: A systematic mapping review}},
  author = {Sam Palmer and Andrew R. Novak and Rhys Tribolet and Mark Langley Watsford and Job Fransen},
  year = {2023},
  doi = {10.1177/17479541231177133},
  url = {https://doi.org/10.1177/17479541231177133},
  abstract = {Team invasion games are sports in which individual team members interact and exchange information to coordinate their behaviours and actions in pursuit of the common goal of winning matches. Researchers have used social network analysis to quantify the cooperative behaviours of sports teams (cooperative network analysis), yet this research exists across an array of disciplines and uses various methods. Therefore, accessibility for practitioners and researchers interested in using it to quantify team cooperation in team invasion games may be limited. This systematic mapping review aimed to identify, report and discuss research in this emerging research area. Articles were systematically searched in electronic databases and reference list scans resulting in 112 papers included. Football was the most studied sport ( n = 91), and passing was the most observed interaction between players within a sports team ( n = 107). This review further revealed a lack of consistency in reporting between the included studies with respect to nomenclature and network measures. A comprehensive map of the current literature on the use of cooperative network analysis in team invasion games is provided which can be used by practitioners and researchers tasked with or interested in analysing team performance.},
  keywords = {sistemas_complejos, futbol},
  note = {Mapa de 112 trabajos sobre redes de cooperación en deportes de invasión, con el fútbol y el pase como protagonistas y una notable falta de uniformidad en las métricas.},
  journal = {International Journal of Sports Science & Coaching}
}

@article{alves2025social,
  title = {{Social network analysis in football: a systematic review of performance and tactical applications}},
  author = {Ricardo Alves and Gonçalo Dias and Nuno André Nunes and Sérgio M. Querido and Vasco Vaz},
  year = {2025},
  doi = {10.3389/fpsyg.2025.1659603},
  url = {https://doi.org/10.3389/fpsyg.2025.1659603},
  abstract = {Introduction: This systematic review aims to critically examine the application of social network analysis (SNA) in football, with a focus on its contribution to evaluating team performance, tactical behavior, and player interactions. Methods: Following PRISMA guidelines, a comprehensive search was conducted across four databases (PubMed, Scopus, Web of Science, and SPORTDiscus) from January 2017 to October 2024. Results: Fifty-five peer-reviewed studies met the inclusion criteria, addressing network analysis in official men's professional football matches. Data were extracted and summarized regarding methodological quality, network metrics used, tactical context, and practical implications. Discussion: Most studies demonstrated that cohesive network structures, characterized by high density, clustering coefficients, and centrality, are associated with successful team performance. Centrality metrics were frequently used to identify key tactical players, typically central defenders and midfielders. Recent methodological advances included dynamic time-window analysis, pitch-passing networks, and spatial-temporal integration using tracking data. However, there remains an overrepresentation of elite men's football and offensive phases, with limited focus on defensive networks, youth categories, and women's football. SNA offers a powerful framework to decode the complexity of football performance, evolving from static graphs to dynamic, rolesensitive, and context-rich models. Future research should adopt longitudinal designs, multi-layer network approaches, and closer collaboration with practitioners to enhance the operational utility of network insights in coaching and performance analysis. Systematic review registration: https://osf.io/2pe3y.},
  keywords = {sistemas_complejos, futbol},
  note = {Revisión de 55 estudios que muestra que las redes de pase más densas y cohesionadas se asocian al rendimiento, y que el campo avanza hacia modelos dinámicos con tracking. Faltan estudios en defensa, base y fútbol femenino.},
  journal = {Frontiers in Psychology}
}

@article{poulard2026from,
  title = {{From rigid marks to robust perception: Practice variability fosters flexible time-to-contact timing in a virtual reality relay simulator}},
  author = {Paul Le Poulard and Martin Egiziano and Gilles Montagne},
  year = {2026},
  doi = {10.1177/17479541261510075},
  url = {https://doi.org/10.1177/17479541261510075},
  abstract = {The 4×100-meter relay presents a fundamental motor paradox: maximizing running speed while ensuring millisecond-precision baton transmission. Traditionally, receivers start when their partner reaches a fixed ground mark, a time-to-passage (TTP) strategy that makes them vulnerable to fluctuations in the partner's approach speed. This study evaluated an immersive virtual reality (VR) relay simulator in which receivers learned to initiate their run at a critical time-to-contact (TTC) with the incoming partner, without any ground mark. Twenty-two novice participants practiced with self-controlled feedback, either at a constant approach speed (stable group) or at three approach speeds varying from trial to trial (variable group). All completed a pre-test, acquisition, a post-test, a five-day retention test and a transfer test at a novel approach speed. Absolute timing error decreased significantly between pre-test and retention in both groups, validating task learning. At transfer, however, accuracy declined markedly in the stable group, whereas the variable group maintained its previously acquired accuracy. The constant error of the stable group (+162 ms) closely matched the value predicted if run initiation relied on an optical correlate of distance (+160 ms), while the near-zero constant error of the variable group (+13 ms) indicated reliance on information about TTC. Practice variability thus breaks the confound between TTC and lower-order optical variables, promoting the use of more robust optical information and behavioral flexibility. Shifting from TTP to TTC-based training in VR offers a promising alternative to rigid ground marks for relay training.},
  keywords = {aprendizaje_talento, pedagogia_no_lineal},
  note = {Estudio con 22 novatos en un simulador VR de relevo: quienes practicaron con velocidades variables transfirieron su precisión a una velocidad nueva y los de práctica constante no. Apoya la variabilidad de práctica como vía hacia información perceptiva más robusta.},
  journal = {International Journal of Sports Science & Coaching}
}

@article{faedo2026fc,
  title = {{FC Barcelona ‘La Masia’ academy: a global brand that drives the club’s identity and sporting excellence}},
  author = {Nahuel Ivan Faedo and Krishna Satish and Xavier Ginesta and Jordi de San Eugenio},
  year = {2026},
  doi = {10.1080/17430437.2026.2760353},
  url = {https://doi.org/10.1080/17430437.2026.2760353},
  abstract = {The primary goal of this research is to examine the crucial role of FC Barcelona’s La Masia academy in developing elite players for the club. It explores how La Masia has contributed to shaping FC Barcelona’s identity, particularly its distinctive style of play. The study combines quantitative and qualitative methodologies. Quantitatively, it analyses data from 1980 to 2024, including first-team squad composition, trophy outcomes, and player market values, using descriptive statistics and comparative analysis. Qualitatively, it draws on in-depth interviews with key figures linked to La Masia’s history, as well as a former professional footballer offering an external perspective. These interviews address the academy’s evolution, development processes, and influence on the club’s identity and success. Findings highlight La Masia’s importance in sustaining sporting performance and institutional identity, while showing its impact is shaped by managerial decisions and external recruitment strategies, contributing to broader discussions on talent development and sport management.},
  keywords = {futbol, aprendizaje_talento},
  note = {Análisis mixto de La Masia entre 1980 y 2024 que liga la academia con la identidad y el estilo del Barça. Su peso depende de las decisiones técnicas y de fichajes externos.},
  journal = {Sport in Society}
}

@article{demirci2026external,
  title = {{External load profiles across game-based training formats, friendly matches, and official matches in elite professional soccer players.}},
  author = {Emre Recep Ali Demirci and Murat Çelik and Yusuf Köklü and Utku Alemdaroğlu},
  year = {2026},
  doi = {10.1186/s13102-026-02039-3},
  url = {https://pubmed.ncbi.nlm.nih.gov/43069218/},
  abstract = {This study compared the per-minute external load profiles of different game-based training formats with those of friendly and official matches in elite professional soccer players. Eighteen elite male professional soccer players competing in the Turkish Super League (age: 26.3 ± 5.2 years; height: 180.9 ± 5.3 cm; body mass: 77.9 ± 5.2 kg) participated in the study. External load data were collected over a three-week competitive period using 15-Hz global positioning system (GPS) devices. Four game-based training formats (3 vs. 3, 8 vs. 8, 9 vs. 9, and 10 vs. 10), together with two friendly matches and two official league matches, were analyzed. All external load variables were expressed per minute of playing time. Total distance (TD), high-speed running distance (HSR), sprint distance, high acceleration-deceleration distance (Acc + Dec), and high metabolic power (HMP) distance were compared using repeated-measures ANOVA. Significant differences were observed across conditions for all variables (all p < 0.001; partial η² = 0.36-0.73). The 3 vs. 3 condition showed the greatest per-minute TD, high Acc + Dec, and HMP distances, whereas friendly and official matches showed the greatest per-minute HSR and sprint distances. Relative to official match play, each condition showed a distinct per-minute external load profile, exceeding match values for some variables while falling below them for others. These values reflect per-minute (rate-based) external load rather than total accumulated load. These findings indicate that game-based training conditions were associated with distinct per-minute external load profiles, with no single condition matching official match play across all variables. Because these per-minute demands were observed in single sessions, the formats may be use},
  keywords = {futbol},
  note = {Con GPS en 18 profesionales, el 3v3 maximiza la carga por minuto de acc/dec y los partidos la de sprint; ningún formato replica el partido.},
  journal = {BMC sports science, medicine & rehabilitation}
}

@article{becerramunoz2026game,
  title = {{Game statistic-based performance indicators in wheelchair basketball: A systematic review of trends and insights}},
  author = {William Becerra-Muñoz and Benedetta Scotto and Javier Pérez-Tejero},
  year = {2026},
  doi = {10.1177/17479541261507170},
  url = {https://doi.org/10.1177/17479541261507170},
  abstract = {Wheelchair basketball (WB) performance analysis has expanded, yet evidence remains dispersed across box-score, observational and model-based approaches, and no synthesis has integrated the indicators, data sources and analytical methods used across player, team and line-up levels. This systematic review examined how game-related statistics (GRS) have been used to analyse WB performance and identified performance indicators, data sources and analytical methods applied in competition. Searches were conducted in Web of Science, PubMed, Scopus and EBSCO-SPORTDiscus, supplemented by Google Scholar and citation tracking. Following PRISMA 2020, studies were eligible if they analysed quantitative match statistics from official WB competitions. Data extraction covered competition context, dataset type, GRS, analytical approach and key findings, and methodological quality was assessed using a 16-item checklist adapted from the Critical Review Form for Quantitative Studies. Eighteen studies were included: 11 used box-score or match-statistics datasets, and 7 used observational sequence-, possession-, shot-, or screen-based datasets. Shooting efficiency, assist- and turnover-related indicators, and rebounding were most consistently associated with success. Functional classification shaped statistical output, although clustering and optimisation studies showed that performance profiles were not determined by classification alone. Most studies relied on descriptive or inferential comparisons, while fewer applied predictive modelling, clustering or Bayesian optimisation. Common limitations included inconsistent standardisation, limited possession-level adjustment and incomplete modelling of contextual and hierarchical structures. WB performance reflects interactions between technical },
  note = {Revisión sistemática PRISMA de 18 estudios sobre indicadores estadísticos de rendimiento en baloncesto en silla de ruedas: tiros, asistencias/pérdidas y rebotes se asocian más con el éxito. Tangencial a tu línea.},
  journal = {International Journal of Sports Science & Coaching}
}

@article{prieto2026cooperacin,
  title = {{Cooperación mediante juegos tradicionales en Educación Física de la Educación Básica ecuatoriana}},
  author = {Janneth Aime Ferruzola Prieto and Yazmin Eloisa Ruiz Jaen and Damaris Sofia Moncayo Paredes and Teresita De Jesús Maldonado Salinas},
  year = {2026},
  doi = {10.23857/pc.v11i11.12903},
  url = {https://polodelconocimiento.com/ojs/index.php/es/article/view/12903},
  abstract = {La enseñanza de la cooperación mediante juegos tradicionales exige distinguir la participación grupal de un aprendizaje social intencional. Este artículo analiza las posibilidades, condiciones y límites de estas prácticas para la Educación Física de la Educación Básica ecuatoriana. Se desarrolló una revisión narrativa crítica de publicaciones académicas recientes, complementada con documentación curricular oficial. La búsqueda se realizó mediante buscadores académicos y portales editoriales, con términos en español e inglés sobre juegos tradicionales, aprendizaje cooperativo, educación física, inclusión y relaciones sociales. Se diferenciaron investigaciones escolares, estudios universitarios, revisiones y aportes conceptuales; además, se explicitó cuándo el acceso se limitó al resumen. La síntesis muestra que las intervenciones cooperativas presentan resultados favorables en distintos dominios educativos, aunque existe heterogeneidad y no puede atribuirse el mismo efecto a cualquier juego tradicional. Los estudios sobre emociones, habilidades motrices y percepciones aportan información complementaria, pero no demuestran por sí solos cambios duraderos en cooperación. La evidencia ecuatoriana examinada ofrece pertinencia cultural y experiencias inclusivas, con restricciones para establecer causalidad o generalizar entre subniveles. Se propone una matriz de coherencia entre reglas, interdependencia, participación equitativa, mediación docente y evaluación observable, acompañada de orientaciones diferenciadas para Preparatoria, Elemental, Media y Superior. Esta contribución constituye una propuesta didáctica pendiente de validación local. Se concluye que el valor educativo depende de cómo se organiza, acompaña y revisa la experiencia compartida, así como de su contextualiz},
  keywords = {aprendizaje_talento},
  note = {Revisión narrativa crítica sobre juegos tradicionales para enseñar cooperación en Educación Física en Ecuador; propone una matriz de coherencia entre reglas, interdependencia y evaluación, aún sin validar.},
  journal = {Polo del Conocimiento}
}

@article{pinder2011representative,
  title = {{Representative Learning Design and Functionality of Research and Practice in Sport}},
  author = {Ross A. Pinder and Keith Davids and Ian Renshaw and Duarte Araújo},
  year = {2011},
  doi = {10.1123/jsep.33.1.146},
  url = {https://doi.org/10.1123/jsep.33.1.146},
  abstract = {Egon Brunswik proposed the concept of "representative design" for psychological experimentation, which has historically been overlooked or confused with another of Brunswik's terms, ecological validity. In this article, we reiterate the distinction between these two important concepts and highlight the relevance of the term representative design for sports psychology, practice, and experimental design. We draw links with ideas on learning design in the constraints-led approach to motor learning and nonlinear pedagogy. We propose the adoption of a new term, representative learning design, to help sport scientists, experimental psychologists, and pedagogues recognize the potential application of Brunswik's original concepts, and to ensure functionality and action fidelity in training and learning environments.},
  keywords = {pedagogia_no_lineal, sistemas_complejos},
  note = {Texto fundacional que introduce el «diseño de aprendizaje representativo» y lo conecta con CLA y pedagogía no lineal.},
  journal = {Journal of Sport and Exercise Psychology}
}

@article{bobrownicki2026promoting,
  title = {{Promoting perception–action coupling in sport: the role of preparation within coaching environments}},
  author = {Ray Bobrownicki and Dave J. Collins and Howie J. Carson and Alan C. Macpherson},
  year = {2026},
  doi = {10.1080/21640629.2026.2657068},
  url = {https://doi.org/10.1080/21640629.2026.2657068},
  abstract = {In recent years, there has been considerable interest in the coupling of perception and action and resultant practices for supporting the exploration of perceptual motor landscapes (e.g. through representative design). Although perception–action coupling can capably explain the organisation of behaviour and action in some contexts, there are also some noteworthy issues and challenges with its scholarship and application (e.g. within coaching or team-sport environments). With this in mind, this paper initially reviews current evidence and associated issues with perception–action coupling and its mechanisms. From here, we offer proposals for addressing identified limitations. In particular, we contend that a priori planning and preparation are key to optimising the efficacy and operation of perception–action coupling within performance settings. As part of this, we explore whether movement control may be better explained by alternative approaches (e.g. predictive processing) and more effectively facilitated through a wider set of coaching andpsychology tools.},
  keywords = {pedagogia_no_lineal, futbol},
  note = {Revisión crítica de 2026 sobre acoplamiento percepción–acción: defiende la preparación a priori y plantea el procesamiento predictivo como alternativa.},
  journal = {Sports Coaching Review}
}

@article{serraolivares2017la,
  title = {{La problemática táctica, clave en el diseño representativo de tareas desde el enfoque de la pedagogía no lineal aplicada al deporte (Tactical problems, key component of the representative design of tasks within the non-linear pedagogy approach applied to}},
  author = {Jaime Serra-Olivares and Javier García-Rubio},
  year = {2017},
  doi = {10.47197/retos.v0i32.51870},
  url = {https://doi.org/10.47197/retos.v0i32.51870},
  abstract = {La enseñanza de los deportes desde las Perspectivas de los Condicionantes del Aprendizaje Motor y las Aproximaciones Basadas en el Juego y su Comprensión, están ampliamente aceptadas en la actualidad. No obstante, existe la necesidad de un entendimiento superior de los conceptos teóricos que originan el diseño representativo de tareas bajo el enfoque de la Pedagogía No Lineal. En este sentido, el propósito de este trabajo es el de proveer a los profesionales de la Educación Física y el entrenamiento de la estrategia de diseño de tareas basada en la lógica interna de cada categoría deportiva, el Enfoque fundamentado en la Problemática Táctica de los Deportes. Para ello: 1) Se exponen algunos de los principios básicos clave de la psicología ecológica y la teoría de los sistemas dinámicos que han contribuido a la construcción de la pedagogía no lineal; 2) Se presentan los aspectos clave de la perspectiva de los condicionantes del aprendizaje motor y de la dinámica contextual de los deportes; 3) Se exponen los principios pedagógicos de las formas de enseñanza basadas en el juego y su comprensión; 4) Se aborda la relación de los principios de la psicología ecológica y los sistemas dinámicos con el diseño de tareas basado en la problemática táctica. Por último, 5) Se expone un ejemplo en fútbol en relación a las posibilidades de esta novedosa estrategia de diseño.Abstract. Nowadays it is widely accepted to teach sports from a motor learning determinant perspective, and a game understanding approach. However, there is a need for a higher understanding of the theoretical concepts that determine the representative design of tasks within the Non-Linear Pedagogy approach. The purpose of this paper is to provide professionals of Physical Education and Sports Coaching with strategie},
  keywords = {pedagogia_no_lineal, futbol},
  note = {Guía en español para diseñar tareas representativas a partir de los problemas tácticos del deporte, con ejemplo en fútbol.},
  journal = {Retos}
}

@phdthesis{schairer2026a,
  title = {{A Qualitative Phenomenological Exploration Of The Use Of The Constraints-Led Approach By Men’s NCAA Lacrosse Coaches}},
  author = {Matthew Schairer},
  year = {2026},
  url = {https://dune.une.edu/edu_diss/73},
  abstract = {Despite the rise of the constraints-led approach (CLA) as a prominent technique for developing athletic skills (Ramos et al., 2020), there is limited research on the experiences of coaches who use the CLA to train their players. The purpose of this qualitative phenomenological study was to explore the lived experiences of men’s NCAA lacrosse coaches using the constraints-led approach. The CLA is a learner-centered coaching methodology (Brymer & Renshaw, 2010) in which athletes develop skills through interacting with constraints to recognize affordances to act (Gibson, 1979), leading to the emergence of self-organization of skills. The analysis of the data collected through semi-structured interviews with eight NCAA Men’s lacrosse coaches revealed three themes: a) coaches used task, environmental, and individual constraints to facilitate skill acquisition, focusing mainly on task constraints, b) coaches designed constraints to reinforce their principles of play, prepare for their upcoming opponents, and maximize time on task. Coaches adjusted their constraints to prioritize representativeness and competitive balance, and c) coaches used variable non-linear training methods to encourage the emergence of self-organization of skills. Findings of this study encouraged coaches who are interested in adopting the CLA to use a four-part plan for implementation: follow a non-linear pedagogy framework, incorporate ample uses of variability, design constraints to create game-like affordances, and prioritize representative learning design to transfer skills from practice to gameday.},
  keywords = {pedagogia_no_lineal, aprendizaje_talento},
  note = {Tesis cualitativa con 8 entrenadores NCAA de lacrosse sobre cómo aplican el CLA. Priorizan restricciones de tarea, representatividad y variabilidad, y proponen un plan de implantación en cuatro pasos.},
  school = {DUNE - DigitalUNE (University of New England)}
}

@article{santana2026avaliao,
  title = {{Avaliação ecológica de habilidades específicas no futebol de base: uma análise por posições durante jogo reduzido 4x4+gr}},
  author = {Carlos Eduardo Pereira de Santana and Eric Tamanini and Matheus de Oliveira Jaime and Suelen Rodrigues da Luz and Wilson Rinaldi and Vanessa Menezes Menegassi},
  year = {2026},
  url = {https://www.rbff.com.br/index.php/rbff/article/view/1695},
  abstract = {Objetivo: O objetivo deste estudo foi investigar o desempenho de habilidades específicas realizadas por jovens futebolistas durante jogo reduzido no formato 4x4+GR em função das posições de jogo. Materiais e métodos: O estudo incluiu 51 atletas de futebol do sexo masculino com idades entre 12.2 e 15.4 anos, das categorias Sub-13 e Sub-15. Foram realizados 6 jogos reduzidos no formato 4x4+GR, 2 tempos de 4 minutos com 2 minutos de recuperação passiva, e para análise das habilidades específicas dos atletas utilizou o Sistema de Avaliação de Habilidades Específicas para o Futebol - SAHEF. Resultados: Para frequência de realização de habilidades ofensivas, “Duelo Ofensivo” (p=0.048*), “Condução” (p=0.002*), “Finalização” (p=0.019*) apresentaram diferença significativa por posições, enquanto defensivas, “Duelo Aéreo Defensivo” (p=0.697) única que não apresentou diferença. Considerando o escore de realização de habilidades ofensivas, “Finalização” apresentou diferença significativa (p=0.036*) e nas defensivas a única que não diferiu significativamente entre as posições foi “Duelo Aéreo Defensivo” (p=0.753). Conclusão: A relevância dos jogos reduzidos como estratégia metodológica para o desenvolvimento técnico-tático dos jovens futebolistas. Além de destacar a importância de incluir o goleiro de forma mais efetiva nas atividades.},
  keywords = {futbol, aprendizaje_talento},
  note = {Estudio con 51 jóvenes en 4x4+GR: la frecuencia de duelo ofensivo, conducción y finalización cambia según la posición, mientras que el resto de la acción técnica es similar. Recomiendan incluir más al portero.},
  journal = {RBFF - Revista Brasileira de Futsal e Futebol}
}

@article{pinto2026o,
  title = {{O analista de desempenho: formação, relação com treinadores e clubes e as perspectivas pedagógicas no futebol brasileiro}},
  author = {Lucas de Carvalho Barbosa Pinto and Gabriel Orenga Sandoval and Rodrigo Gonçalves and Alcides Jose José Scaglia},
  year = {2026},
  url = {https://www.rbff.com.br/index.php/rbff/article/view/1675},
  abstract = {The professionalization of high-performance sports has promoted significant changes in the internal processes of football teams. Among these changes, we highlight the search for a more detailed understanding of the game, high investment in technologies for data collection and analysis, as well as the inclusion of new professionals in technical committees, known as performance analysts and/or game analysts. Given this context, the present study, through a qualitative approach and semi-structured interviews, aimed to investigate the performance of performance analysts in the national scenario, with an emphasis on their pedagogical role. The results indicate that the predominant results-oriented logic in clubs hinders the performance of these professionals, who are often perceived as mere data reproducers and cameramen, with their function limited to providing information that supports the coaches' decisions. Despite these restrictions, the analysts interviewed recognize the relevance of their pedagogical role in training players, but face barriers when developing strategies that include athletes in the knowledge-building process.},
  keywords = {futbol, pedagogia_no_lineal},
  note = {Entrevistas a analistas brasileños: el análisis puede ser pedagógico, sobre todo en base, pero la cultura de resultados lo reduce a transmitir datos.},
  journal = {RBFF - Revista Brasileira de Futsal e Futebol}
}

@article{leonardo2026competio,
  title = {{Competição de futebol infantil dos jogos escolares do amazonas: análise do regulamento a partir das lentes da pedagogia do esporte}},
  author = {Lucas Leonardo and Mateus Azevedo Mendonca and João Cláudio Machado and Tathyane Krahenbühl and Enrique Ortega Toro},
  year = {2026},
  url = {https://www.rbff.com.br/index.php/rbff/article/view/1676},
  abstract = {Organized sports programs for children and youth establish an intrinsic relationship among sporting activities, training planning, and participation in competitions. This study aims to analyze the organizational structure of the Football Championship of the Amazonas School Games (JEAs) in the under-14 category, overseen by the State Secretariat for Sport and Leisure (SEDEL) and the State Secretariat for Education and Quality of Teaching (SEDUC), and to assess the extent to which the competition is adapted to the needs of this age group. To this end, a documentary analysis was conducted based on the official regulations and bulletins of the Amazonas School Games competitions. A 1-to-4 scoring scale was applied, where 1 represents highly adapted competitions and 4 corresponds to traditional competition formats. The JEAs received a score of 3.15 ± 0.70. The findings highlight a clear need for greater efforts by SEDEL and SEDUC to promote competitions better suited to children.},
  keywords = {futbol, aprendizaje_talento},
  note = {Los reglamentos escolares de Amazonas están cerca del modelo adulto tradicional (3,15/4). Piden competiciones más inclusivas y con fútbol reducido.},
  journal = {RBFF - Revista Brasileira de Futsal e Futebol}
}

@article{basso2026impacto,
  title = {{Impacto do discurso e metodologia do treinador no desempenho de uma equipe universitária de futsal: das sessões de treinamento aos jogos}},
  author = {Matheus Cassab Basso and Márcio Pereira Morato},
  year = {2026},
  url = {https://www.rbff.com.br/index.php/rbff/article/view/1690},
  abstract = {Futsal presents a certain level of complexity due to tactical-technical interactions and the constant need for decision-making. The aim of this study was to describe and analyze the training process of a university futsal team, considering the coach’s conceptions, the training sessions, and the team’s performance during matches. This is a single case study conducted with a team composed of fifteen female athletes who participated in university competitions in 2024. The study was developed in three stages: (a) a semi-structured interview with the coach; (b) systematic recording and categorization of training sessions using the SIATE protocol; and (c) match analysis based on the criteria defined by the coach. The results highlighted the predominance of global and situational methods, with the game assuming a central role in teaching-training. This approach ensures coherence between discourse, training, and in-game behavior, especially regarding defensive actions and fast transitions. However, less systematization of offensive content was observed, reflecting limitations in the coach’s ideal game model compared to what occurs on the court. It is concluded that the periodization of tactical content is essential to enhance collective consistency, and the global method is a suitable alternative for teams with limited weekly training time.},
  keywords = {futbol, aprendizaje_talento},
  note = {Caso de un equipo de futsal que entrena con juegos situacionales 4vs4/5vs5: hay coherencia entre discurso, entreno y partido salvo en ataque, menos sistematizado.},
  journal = {RBFF - Revista Brasileira de Futsal e Futebol}
}

@article{coutinho2018the,
  title = {{The effects of an enrichment training program for youth football attackers}},
  author = {Diogo Coutinho and Sara Diana Leal dos Santos and Bruno V. Gonçalves and Bruno Filipe Rama Travassos and Del P. Wong and Wolfgang Immanuel Schöllhorn and Jaime E. Sampaio},
  year = {2018},
  doi = {10.1371/journal.pone.0199008},
  url = {https://doi.org/10.1371/journal.pone.0199008},
  abstract = {The aim of this study was to identify the effects of a complementary training program based on differential learning approach in the physical, technical, creative and positioning performance of youth football attackers. Fifteen players were allocated into the control (U15C = 9, age: 13.9±0.5 years; U17C = 6, age: 16.1±0.7 years) and the experimental (U15E = 9, age: 14.2±0.8 years; U17E = 6, age: 15.8±0.5 years) groups. The experimental groups participated in 10-weeks of a complementary training program based on differential learning approach to improve physical literacy and players' tactical behavior. Variables studied encompassed: motor (vertical jump, speed and repeated change-of direction), technical (pass, dribble and shot), creative (fluency, attempts, versatility) and positioning-related variables (stretch index, spatial exploration index and regularity of the lateral and longitudinal movements). Results revealed that U15E improved both the jump and repeated change-of-direction performance, while the U17E have only improved the jump performance. The U15E showed improvements in all technical variables (small to large effects), and in the fluency and versatility (moderate effects), while the U17 have only improved the successful shots (large effects). From a positional perspective, there was a moderate increase in the stretch index, and decreased longitudinal and lateral regularity (small to moderate effects) in the U15E compared to the U15C. In turn, the U17E revealed a moderate increase of the spatial exploration index and a small decrease in the stretch index. Overall, the results suggest that the complementary training program was effective for the development of the overall performance of the U15E attackers, while more time and/or variability may be needed for },
  keywords = {pedagogia_no_lineal, futbol, aprendizaje_talento},
  note = {Ensayo con 15 atacantes juveniles: 10 semanas de aprendizaje diferencial mejoraron algunas medidas físicas (cambio de dirección, CMJ) respecto al entrenamiento habitual.},
  journal = {PLoS ONE}
}

@article{sullivan2021towards,
  title = {{Towards a contemporary player learning in development framework for sports practitioners}},
  author = {Mark O Sullivan and Carl T. Woods and James Vaughan and Keith Davids},
  year = {2021},
  doi = {10.1177/17479541211002335},
  url = {https://doi.org/10.1177/17479541211002335},
  abstract = {As it is appreciated that learning is a non-linear process – implying that coaching methodologies in sport should be accommodative – it is reasonable to suggest that player development pathways should also account for this non-linearity. A constraints-led approach (CLA), predicated on the theory of ecological dynamics, has been suggested as a viable framework for capturing the non-linearity of learning, development and performance in sport. The CLA articulates how skills emerge through the interaction of different constraints (task-environment-performer). However, despite its well-established theoretical roots, there are challenges to implementing it in practice. Accordingly, to help practitioners navigate such challenges, this paper proposes a user-friendly framework that demonstrates the benefits of a CLA. Specifically, to conceptualize the non-linear and individualized nature of learning, and how it can inform player development, we apply Adolph’s notion of learning IN development to explain the fundamental ideas of a CLA. We then exemplify a learning IN development framework, based on a CLA, brought to life in a high-level youth football organization. We contend that this framework can provide a novel approach for presenting the key ideas of a CLA and its powerful pedagogic concepts to practitioners at all levels, informing coach education programs, player development frameworks and learning environment designs in sport.},
  keywords = {pedagogia_no_lineal, futbol, aprendizaje_talento},
  note = {Marco para llevar el CLA y la dinámica ecológica a los itinerarios de formación de jugadores, ilustrado con una organización juvenil de fútbol.},
  journal = {International Journal of Sports Science & Coaching}
}

@article{machado2018enhancing,
  title = {{Enhancing learning in the context of Street football: a case for Nonlinear Pedagogy}},
  author = {João Cláudio Machado and Daniel Barreira and Larissa Rafaela Galatti and Jia Yi Chow and Júlio Garganta and Alcides José Scaglia},
  year = {2018},
  doi = {10.1080/17408989.2018.1552674},
  url = {https://doi.org/10.1080/17408989.2018.1552674},
  abstract = {Background: Street football can be understood as the most natural way to learn football and it can be a great starting point to develop perceptual, decisional, tactical and motor skills. Importantly, players involved in Street football may develop a strong emotional bond to the game through their experiences playing in an informal setting and eventually this could support their participation in a more structured playing environment. However, nowadays, talented children have reduced opportunities to play the game in this informal environment and instead, are mostly experiencing the game through their participation in organised settings such as in youth football clubs and academies. Importantly, such structured and formal environments afford the children a more rigid and less representative learning environment, which could potentially inhibit the development of creativity and adaptability among these young players.Purpose: The current paper aims to discuss the importance of Street football to players’ development and the role of a Nonlinear Pedagogy (NLP) framework to support the design of a player-centred and game-based approach that can contribute to enhance learning of creative and adaptive behaviours in football.Discussion: Pedagogical principles of NLP (representative learning design, information-movement couplings, manipulation of constraints, exploratory learning and reducing conscious control of movement) underpinned by concepts from Ecological Dynamics and working through pedagogical channels (instruction, feedback and practice) can facilitate the design of representative training tasks to enhance learning. NLP emphasises a learner-centred approach and highlights the critical role that the practitioner plays as a facilitator in providing learners with meaningful},
  keywords = {pedagogia_no_lineal, futbol, aprendizaje_talento},
  note = {Plantea que el fútbol callejero favorece la creatividad y que la pedagogía no lineal permite replicar esa riqueza en academias.},
  journal = {Physical Education and Sport Pedagogy}
}

@article{hutauruk2026pengaruh,
  title = {{PENGARUH PENDEKATAN CONSTRAINTS-LED APPROACH BERBASIS MODIFIKASI UKURAN LAPANGAN DAN KARAKTERISTIK BOLA TERHADAP PENINGKATAN KOORDINASI MATA-TANGAN, KEMAMPUAN ADAPTASI GERAK, DAN KETERAMPILAN BERMAIN TENIS LAPANGAN PADA MAHASISWA PEMULA.}},
  author = {Alfrian Sisko Hutauruk and Christian Sitopu and Dita Uli Lumban Gaol and Cyindi Aulia Hutabarat and Zainal Arif Harahap and Nurkadri},
  year = {2026},
  doi = {10.23969/jp.v11i4.74872},
  url = {https://journal.unpas.ac.id/index.php/pendas/article/view/74872},
  abstract = {Pembelajaran tenis lapangan pada mahasiswa pemula sering kali terhambat oleh penggunaan ukuran lapangan standar dan bola bertekanan tinggi yang tidak sesuai dengan kapasitas psikomotorik pemain pemula, sehingga memicu tingginya tingkat kegagalan pukulan dan lambatnya penguasaan teknik. Penelitian ini bertujuan untuk menganalisis pengaruh penerapan pendekatan Constraints-Led Approach (CLA) berbasis modifikasi ukuran lapangan dan karakteristik bola terhadap peningkatan koordinasi mata-tangan, kemampuan adaptasi gerak, dan keterampilan bermain tenis lapangan pada mahasiswa pemula. Penelitian ini menggunakan metode eksperimen semu (quasi-experimental) dengan desain pretest-posttest control group design. Subjek penelitian berjumlah 40 mahasiswa pemula yang dipilih melalui teknik purposive sampling dan dibagi secara merata ke dalam kelompok eksperimen (n = 20) yang mendapatkan perlakuan pendekatan CLA berbasis modifikasi dimensi lapangan (lapangan mini/transisional) dan bola kompresi rendah (low-compression balls), serta kelompok kontrol (n = 20) yang mengikuti pembelajaran konvensional berbasis instruksi teknik pada lapangan dan bola standar selama 16 pertemuan. Pengumpulan data dilakukan menggunakan tes lempar-tangkap bola tenis untuk mengukur koordinasi mata-tangan, tes respons variasi arah dan kecepatan pantulan (dynamic movement adaptability test) untuk mengukur kemampuan adaptasi gerak, serta tes keterampilan dasar tenis lapangan (Hewitt’s Tennis Achievement Test yang dimodifikasi) untuk mengukur keterampilan bermain. Analisis data menggunakan uji Paired Sample t-Test dan Multivariate Analysis of Variance (MANOVA) pada taraf signifikansi . Hasil penelitian menunjukkan bahwa pendekatan CLA berbasis modifikasi ukuran lapangan dan karakteristik bola memberikan pengaruh yan},
  keywords = {pedagogia_no_lineal, aprendizaje_talento},
  note = {Cuasi-experimento con 40 universitarios que compara CLA (pista reducida y bolas blandas) con instrucción técnica tradicional en tenis. Reportan mejoras en coordinación, adaptación y habilidades de juego. Solo he podido leer el resumen.},
  journal = {Pendas Jurnal Ilmiah Pendidikan Dasar}
}

@article{souza2026pedagogia,
  title = {{Pedagogia do esporte e futsal: uma revisão de escopo}},
  author = {Guilherme Rodrigues de Souza and Guilherme Félix Pereira and Maria Thereza Oliveira Souza},
  year = {2026},
  doi = {10.5007/2175-8042.2026.e114480},
  url = {https://doi.org/10.5007/2175-8042.2026.e114480},
  abstract = {A modalidade futsal é amplamente praticada no Brasil e consolidada no meio investigativo no campo da Educação Física, mas há carência de estudos que sistematizem discussões metodológicas da Pedagogia do Esporte aplicadas à modalidade. Este estudo teve como objetivo identificar na literatura as discussões relacionadas à Pedagogia do Esporte e o ensino do futsal. Trata-se de uma revisão de escopo, conduzida conforme o PRISMA-ScR, com a questão norteadora estruturada pelo acrônimo PCC. A busca foi realizada nas bases SciELO, Biblioteca Virtual da Saúde (BVS), Redalyc, Scopus e Web of Science. Após aplicação do critério de elegibilidade, nove artigos foram escolhidos para a amostra final, evidenciando três eixos temáticos: métodos de ensino; formação de professores e treinadores; dimensões socioeducativas. Os resultados apontam superioridade das abordagens centradas na tomada de decisão frente a métodos analíticos. Conclui-se que o ensino do futsal passa por transformação metodológica gradual, com distanciamento entre conhecimento acadêmico e práticas pedagógicas adotadas.},
  keywords = {pedagogia_no_lineal, futbol, aprendizaje_talento},
  note = {Revisión de alcance de 9 estudios sobre pedagogía del deporte aplicada al futsal. Las evidencias favorecen enfoques centrados en la decisión táctica frente a los analíticos, aunque la base es escasa y heterogénea.},
  journal = {Motrivivência}
}

@article{andrade2026relao,
  title = {{RELAÇÃO ENTRE FORMAÇÃO ESPORTIVA E COORDENAÇÃO MOTORA EM PRATICANTES DE FUTEBOL: UMA REVISÃO NARRATIVA}},
  author = {Murilo José de Andrade and Guilherme Vinicius Cardoso Ribas and Sabrine Nayara Costa},
  year = {2026},
  doi = {10.51891/rease.v12i11.32501},
  url = {https://doi.org/10.51891/rease.v12i11.32501},
  abstract = {Este estudo teve como objetivo analisar as evidências disponíveis sobre a relação entre formação esportiva sistematizada e coordenação motora em praticantes de futebol. Trata-se de uma revisão bibliográfica narrativa, realizada nas bases SciELO, PubMed e Biblioteca Virtual em Saúde (LILACS/MEDLINE), com estudos publicados entre 2000 e 2025 em português, inglês e espanhol. Foram selecionados quatro estudos, organizados em três eixos temáticos. Os estudos descrevem a coordenação e o desempenho motor de jovens praticantes de futebol e fatores associados, sem comparar diretamente atletas com e sem formação em categorias de base. Idade, maturação biológica, composição corporal e estímulos de treino associaram-se à evolução do desempenho motor; as habilidades motoras fundamentais mediaram a relação entre aptidão física e desempenho técnico; e o único estudo que comparou locais de prática não encontrou diferença global na coordenação com bola. Conclui-se que as evidências sobre essa relação são indiretas, limitadas e heterogêneas, sendo recomendados estudos longitudinais com protocolos padronizados, incluindo comparações diretas entre jogadores com e sem formação em categorias de base.},
  keywords = {futbol, aprendizaje_talento},
  note = {Revisión narrativa de 4 estudios sobre formación deportiva y coordinación motora en fútbol. Concluye que la evidencia es indirecta y heterogénea y pide estudios longitudinales con comparación directa.},
  journal = {Revista Ibero-Americana de Humanidades, Ciências e Educação}
}

@article{dura2026balonmano,
  title = {{Balonmano en juego: expansión de reglas para el aprendizaje táctico}},
  author = {José Serrano Durá},
  year = {2026},
  doi = {10.5281/zenodo.24398882},
  url = {https://doi.org/10.5281/zenodo.24398882},
  abstract = {Material docente para el aprendizaje táctico del balonmano mediante cartas que incorporan modificaciones y reglas complementarias en situaciones de juego. Las propuestas plantean problemas tácticos contextualizados que el alumnado debe percibir, decidir y resolver, facilitando la aplicación práctica de los contenidos y el análisis de cómo las reglas modifican las decisiones y posibilidades de acción. Se dirige principalmente al profesorado y al alumnado universitario de Ciencias de la Actividad Física y del Deporte, especialmente en asignaturas de deportes colectivos, y puede adaptarse a otros contextos de enseñanza de la Educación Física.},
  keywords = {aprendizaje_talento},
  note = {Material docente en cartas que modifican reglas de balonmano para generar problemas tácticos y analizar cómo las reglas condicionan las decisiones.},
  journal = {Zenodo (CERN European Organization for Nuclear Research)}
}

@article{dura2026voleibol,
  title = {{Voleibol en juego: cartas de expansión de reglas para el aprendizaje táctico}},
  author = {José Serrano Durá},
  year = {2026},
  doi = {10.5281/zenodo.24398266},
  url = {https://doi.org/10.5281/zenodo.24398266},
  abstract = {Material docente para el aprendizaje táctico del voleibol mediante cartas que introducen modificaciones de las reglas y generan situaciones de juego que requieren observar, interpretar y resolver problemas tácticos. Su uso ayuda a aplicar los fundamentos del juego en contextos modificados, favorece la toma de decisiones y permite analizar cómo las reglas condicionan las posibilidades de acción. Se dirige principalmente al profesorado y al alumnado universitario de Ciencias de la Actividad Física y del Deporte, especialmente en asignaturas de deportes colectivos, y puede adaptarse a otros contextos de enseñanza de la Educación Física.},
  keywords = {aprendizaje_talento},
  note = {Cartas de expansión de reglas para aprender táctica de voleibol mediante situaciones de juego modificadas.},
  journal = {Zenodo (CERN European Organization for Nuclear Research)}
}

@article{oliveira2026jogos,
  title = {{JOGOS ESPORTIVOS COLETIVOS COMO PRÁTICA PEDAGÓGICA PARA O ENSINO DO FUTEBOL NA EDUCAÇÃO FÍSICA ESCOLAR}},
  author = {Ubirajara de Oliveira and VALDIONE DOS SANTOS RIBEIRO},
  year = {2026},
  url = {https://revistas.ufrj.br/index.php/am/article/view/77793},
  abstract = {Football is the most requested sport content in Physical Education classes, yet its teaching frequently reproduces technicist and exclusionary logics, limiting learning to the repetition of motor gestures. This study aimed to explore Collective Sports Games (CSG) as a pedagogical practice for teaching football in the final years of Elementary School, identifying technical-tactical and sociocultural contributions of this approach. Action research was adopted as a methodology, with 35 students from two 9th-grade classes at a municipal school in Linhares/ES participating during the second term of 2022. The intervention was structured in three stages: initial diagnosis, a progressive sequence of games, and conversation circles, addressing technical, tactical, and sociocultural axes. Data were produced through structured observation, audio and video recordings, and a field journal, and analyzed through content analysis. Results indicated technical-tactical improvement, greater student engagement and protagonism, and critical reflections on gender, racism, and violence in sport. It is concluded that CSG constitute a promising pedagogical alternative for teaching football at school, fostering technical-tactical learning and sociocultural reflection.},
  keywords = {futbol, aprendizaje_talento},
  note = {Investigación-acción con 35 alumnos de 9.º curso: una secuencia de juegos colectivos para enseñar fútbol mejoró la evolución técnico-táctica y la implicación según los autores, sin medidas cuantitativas.},
  journal = {Arquivos em Movimento}
}

@article{bischofberger2026evaluating,
  title = {{Evaluating the “Players First” Game Model Using Large-Scale Tracking Data}},
  author = {Jonas Bischofberger and Runqing Ma and Arnold Baca},
  year = {2026},
  doi = {10.36950/2026.5ciss020},
  url = {https://doi.org/10.36950/2026.5ciss020},
  abstract = {Introduction & Purpose Game models – integrated collections of principles that determine a desired team identity and player behaviours – are paramount in modern elite football coaching. In practice, quantitative methods typically operate on untested ontologies derived from pre-existing game models (Corsie et al., 2024; Rocha & Lopes, 2025). This work pilots an alternative paradigm evaluating game models from an outside perspective. We evaluate Players First (PF), a game model of the Austrian Football Federation (ÖFB) that assigns players into four in-possession and four out-of-possession roles (“PF roles”) based on their positions relative to the ball and the penalty area. We examine whether PF roles distinguish teams, and whether the role-specific tasks recommended by PF are sound and consistent. For the latter analysis, we use Dangerous Accessible Space (DAS) (Bischofberger & Baca, 2026), relating positional geometry to tactical meaning. Methods We use positional and event data from 402 matches across major European competitions: the Men’s European Championship 2024, the Women’s European Championship 2025, the Nations League 2025, and the European Qualifiers for the Men’s World Cup 2026. PF roles and tasks are operationalized according to the Players First specification (Figure 1). A PERMANOVA shows whether the role configuration in individual tracking frames differs (a) between teams and (b) between formations. Furthermore, we evaluate PF’s role-level recommendations using geometric analyses and DAS-based metrics. DAS and role counts are corrected by longitudinal ball position using LOESS regression. Results PERMANOVA shows that team identity explains significant variance in offensive PF role distribution (R² = 0.29, F(53,740) = 6.05, p < 0.001) while the starting fo},
  keywords = {futbol, sistemas_complejos},
  note = {Comunicación que pone a prueba con 402 partidos el modelo «Players First» de la federación austriaca; los roles distinguen a los equipos (R² = 0,29). Solo he leído el resumen parcial.},
  journal = {Current Issues in Sport Science (CISS)}
}

@article{ricogonzalez2021reference,
  title = {{Reference values for collective tactical behaviours based on positional data in professional football matches: a systematic review}},
  author = {Markel Rico-González and José Pino‐Ortega and Julen Castellano and José M. Oliva‐Lozano and Asier Los Arcos},
  year = {2021},
  doi = {10.5114/biolsport.2021.102921},
  url = {https://doi.org/10.5114/biolsport.2021.102921},
  abstract = {Match collective tactical behaviours can be used as a reference to design and select training strategies to improve individual and team performance in professional football.The aim of the systematic review was to cluster the collective tactical variables used to highlight and compare male soccer teams' collective behaviour during professional official matches, providing reference values for each of them.A systematic review of relevant articles was carried out using three electronic databases (PubMed, SPORTdiscus and Web of Science).From a total of 1,187 studies initially found, 13 original articles were included in the qualitative synthesis.The articles found concerned studies carried out on the Spanish, Portuguese, English and Brazilian 1 st divisions and during the European UEFA Champions League.The team length and width ranged from 31 to 46 m and from 35 to 48 m, respectively.The distance from a defending team's goalkeeper to the nearest teammate ranged from 9 ± 6 to 30 ± 7 m, the goal line-recovery location from 27 to 37 m, and the opponent's goal line from 42 to 50 m.The stretch index ranged from 7 to 16 m.Mean team area was ~900 m 2 and the area of the pitch which included all outfield players divided by the 20 outfield players ranged from 79 ± 15 to 94 ± 16 m 2 .All studies provided greater distance and area values during the team-possession phase in comparison to the non-possession one.The ball location on the pitch determined the collective tactical behaviour of the teams.The differences between halves in the distance and area values were contradictory.Further studies should assess the effect of the interaction between the contextual factors on the collective tactical behaviour to obtain more accurate references.This could help football coaches in the design of},
  keywords = {futbol, sistemas_complejos},
  note = {Revisión sistemática de 13 estudios que reúne valores de referencia de comportamiento táctico colectivo en fútbol profesional (longitud, anchura, área, estiramiento) y su variación con la posesión.},
  journal = {Biology of Sport}
}

@article{rochael2023designing,
  title = {{Designing small-sided games for counter-attack training in youth soccer}},
  author = {Marcelo Rochael and Gibson Moreira Praça},
  year = {2023},
  doi = {10.1177/17479541231170830},
  url = {https://doi.org/10.1177/17479541231170830},
  abstract = {The present study aimed to test different designs of counter-attacking training on tactical behaviour by manipulating the number of players and time pressure (limitation on the duration of the players’ offensive action). Specifically, we compared the influence of time pressure and numerical superiority (through an additional player) on the players’ performance and tactical behaviour in small-sided games (SSGs). Forty under-17 soccer athletes participated in the study. The athletes performed 4 SSGs in the following configurations: numerical equality and time pressure (GR-4 × 4-GR – TP); numerical equality and no time pressure (GR-4 × 4-GR – NTP); numerical superiority and time pressure (GR-5 × 4-GR – TP) and numerical superiority and no time pressure (GR-5 × 4-GR – NTP). Tactical performance was evaluated using the Game Performance Evaluation Tool (GPET), and tactical behaviour using positional data measured by the Global Positioning System. The statistical analysis was performed using two-way repeated measures analysis of variance. There was a better tactical performance in decision-making (0.669 ± 0.135, p = .02 and r = .27) and execution (0.602 ± 0.134, p = .002 and r = .44) of technical-tactical actions in the SSG without the time pressure rule. Furthermore, the space exploration index showed lower values (5.634 ± 0.604, p = .007 and r = .32) in games with time pressure than in games without this rule, and there were no significant differences for player length and width behaviour between protocols. It is concluded that the time pressure rule reduces the exploratory behaviour of the players. Understanding these effects allows coaches to plan better training sessions that address the contents of counter-attacks in SSG.},
  keywords = {pedagogia_no_lineal, futbol},
  note = {40 sub-17 jugaron cuatro juegos reducidos de contraataque. La presión de tiempo empeoró decisión y ejecución y redujo la exploración del espacio; la superioridad numérica no cambió longitud ni anchura.},
  journal = {International Journal of Sports Science & Coaching}
}

@article{martinbarrero2026impacto2,
  title = {{Impacto de la metodología no lineal sobre variables técnicas y cinemáticas en el entrenamiento de fútbol}},
  author = {Alberto Martín-Barrero and Francisco Ignacio Martínez-Cabrera and Dima Marius-Dumitru},
