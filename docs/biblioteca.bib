@article{supriadi2026tactical,
  title = {{Tactical decision-making following filanesia-based ecological dynamics in youth football through a multisite cluster-randomized trial}},
  author = {Amir Supriadi and Ibrahim Ibrahim and Asep Suharta and Nimrot Manalu and Rahma Dewi and Muhammad Reza Destya},
  year = {2026},
  doi = {10.58524/jcss.v5i4.1469},
  url = {https://doi.org/10.58524/jcss.v5i4.1469},
  abstract = {Background: National playing philosophies can guide youth development, but whether a culturally situated framework offers lasting benefits beyond generic game-based practice remains unclear. Aims: This study compared Filanesia-based ecological dynamics (Filanesia-ED), generic ecological dynamics (Generic-ED), and conventional coaching for retained tactical decision-making, multidomain tactical adaptation, and pressure-stratified decision accuracy. Methods: A multisite three-arm cluster-randomized trial involved 144 players nested in 12 youth football teams in Lampung and North Sumatra, Indonesia. Teams completed 16 sessions over eight weeks, with assessment at pretest, posttest, and four-week retention. Analyses included longitudinal tactical outcomes, 9,806 match-decision events, 192 fidelity observations, and 1,152 small-sided-game GPS records. Player outcomes were analyzed longitudinally, and decision events were examined using generalized estimating equations. Findings were interpreted in the context of 12 randomized teams. Result: The longitudinal model showed a condition-by-time interaction, Wald χ²(4) = 363.83, p < .001. At posttest, the adjusted Filanesia-ED advantage was 12.59 points versus conventional coaching (95% CI [8.51, 16.67]) and 6.32 points versus Generic-ED (95% CI [2.25, 10.39]); corresponding retention differences were 11.33 and 6.75 points. In the event-level analysis, Filanesia-ED had higher odds of a correct decision under high opponent pressure than conventional coaching, OR = 1.74, 95% CI [1.33, 2.27], p < .001. Conclusion: Filanesia-ED was associated with higher posttest and retained tactical decision-making scores than either comparison. Multidomain findings are exploratory; replication across more teams and longer competitive follow-up is w},
  keywords = {pedagogia_no_lineal, futbol, aprendizaje_talento},
  note = {Ensayo aleatorizado por clústeres con 144 jóvenes futbolistas: la dinámica ecológica adaptada culturalmente mejoró las decisiones tácticas más que la genérica y que el entrenamiento convencional, con efecto retenido a 4 semanas y ventaja bajo alta presión.},
  journal = {Journal of Coaching and Sports Science}
}

@article{beyerlein2026blocked,
  title = {{Blocked vs. randomized practice shapes coordination across adaptation, retention, and transfer following perturbation-based balance training in young adults}},
  author = {Melina Beyerlein and Michael Herzog and Bernd J. Stetter and Thorsten Stein},
  year = {2026},
  doi = {10.3389/fspor.2026.1993425},
  url = {https://doi.org/10.3389/fspor.2026.1993425},
  abstract = {Perturbation-based balance training (PBT) improves reactive balance control, but it remains unclear whether increased practice variability, particularly the contextual interference effect (CIE), enhances retention and transfer. This study investigated whether blocked vs. randomized PBT schedules differently influence adaptation, retention, transfer, and coordination patterns. Thirty-two healthy young adults completed a single-session PBT with repeated trip perturbations under either a blocked or randomized schedule. Retention and intra-task transfer were evaluated using trained and untrained trip perturbations, and inter-task transfer was tested with a simulated forward fall. Dynamic stability performance was assessed using the margin of stability (MoS), and whole-body kinematic synergies (kSYNs) were extracted via principal component analysis to investigate coordinative changes. No significant improvements in MoS were observed during practice, and contrary to expectations derived from the CIE, randomized practice did not show superior retention, or transfer compared to blocked practice at the performance level. kSYNs revealed training-related adaptations and group differences, including changes in knee flexion contribution and stepping coordination. However, limited shared kSYNs between perturbed walking and simulated forward falls indicate strong task specificity. Together, these findings suggest that practice schedule influenced coordination patterns but did not translate into superior stability outcomes in young adults following single-session PBT.},
  keywords = {aprendizaje_talento, sistemas_complejos},
  note = {Con 32 adultos, la práctica aleatorizada no superó a la bloqueada en retención ni transferencia tras entrenamiento de perturbaciones, aunque cambió los patrones de coordinación; la transferencia fue muy específica de la tarea.},
  journal = {Frontiers in Sports and Active Living}
}

@article{koslowsky2026beyond,
  title = {{"Beyond practice hours"- A systematic review of elite football development pathways.}},
  author = {Mars Koslowsky and Paul Larkin and Michael Spittle},
  year = {2026},
  doi = {10.3389/fspor.2026.1989399},
  url = {https://pubmed.ncbi.nlm.nih.gov/43047972/},
  abstract = {This systematic review synthesised research on the developmental activities of elite male football players and evaluated what existing evidence reveals about variation in developmental pathways across populations and contexts. Guided by the Developmental Model of Sport Participation, a framework synthesis was employed to integrate predominantly quantitative data within a qualitative, context-sensitive approach. Eighteen peer-reviewed studies were included following PRISMA 2020 guidelines, examining engagement in domain-specific activities (structured training, competition and informal play) and non-domain-specific activities (other sports). Early exposure to football was consistent across the reviewed studies, with differentiation towards elite performance emerging during adolescence through increased structured, coach-led practice. Evidence supporting early diversification was inconsistent, while engagement in informal play varied considerably across populations. Although developmental activity patterns differed between populations, the primary studies rarely measured the socio-cultural, institutional or environmental conditions potentially associated with these differences. The review extends existing knowledge by distinguishing between evidence describing what elite players did during development and evidence explaining why particular developmental pathways emerged. The findings suggest that expertise development may reflect a dynamic interaction between structured training and socio-cultural environments, supporting a context-dependent understanding of football expertise. Future research should combine developmental activity histories with direct measurements of contextual factors to better explain how different pathways to elite football emerge. PROSPERO identifier},
  keywords = {futbol, aprendizaje_talento},
  note = {Revisión sistemática de 18 estudios: la élite en fútbol combina exposición temprana con más práctica estructurada en la adolescencia; la diversificación temprana no está clara y falta medir el contexto sociocultural.},
  journal = {Frontiers in sports and active living}
}

@article{shaheed2026impact,
  title = {{Impact of Brainstorming-Driven Bounded Spaces Method on Developing Certain Creative Kinesthetic Abilities in Intermediate School Students}},
  author = {Salim Abdulridha Shaheed},
  year = {2026},
  doi = {10.66968/s5e62f93},
  url = {https://doi.org/10.66968/s5e62f93},
  abstract = {Backgroud: Traditional physical education instruction in soccer frequently relies on decontextualized command drills that detach motor execution from perceptual problem-solving. This study investigates the pedagogical impact of an 8-unit brainstorming-driven small-sided games curriculum (bounded spaces method) on developing fundamental soccer skills (ball control, slalom dribbling, and target shooting accuracy) and motor decision-making among male intermediate school students. Methods: A quasi-experimental non-equivalent control group pre-test/post-test design was conducted with 30 male second-intermediate students (aged 13–14 years) at Al-Haritha High School for Outstanding Students in Basra, Iraq, during the 2023–2024 academic year. Participants were assigned to an experimental group (n = 15, instructed via brainstorming-driven small-sided games across 4 weeks, 2 sessions/week, 45 min/session) or a control group (n = 15, instructed via conventional direct command drills). Skill batteries demonstrated high test-retest reliability (r = 0.86–0.89). Data were evaluated using paired and independent t-tests (df = 14 and df = 28), 95% confidence intervals, and effect size calculations (Cohen's d and Hedges' g). Results: While pre-test baseline measures confirmed group equivalence (p > 0.80), post-test evaluations demonstrated statistically significant superiority for the experimental group across all technical measures: ball control (mean = 8.933 vs. 7.733 points, t = 2.369, p = 0.025, Cohen's d = 0.866, 95% CI [0.163, 2.237]), dribbling agility time (mean = 12.951 s vs. 14.289 s, t = 3.229, p = 0.003, Cohen's d = -1.180, 95% CI [-2.187, -0.489]), and shooting accuracy (mean = 9.066 vs. 7.866 points, t = 2.662, p = 0.013, Cohen's d = 0.973, 95% CI [0.277, 2.123]). Conclusion},
  keywords = {pedagogia_no_lineal, futbol, aprendizaje_talento},
  note = {En 30 escolares, 4 semanas de juegos reducidos con lluvia de ideas mejoraron control, regate y tiro más que el mando directo; diseño cuasi-experimental pequeño.},
  journal = {International Journal of Experimental Sports Science Research}
}

@article{silva2026tactical,
  title = {{Tactical periodisation as an integrated methodological approach in football: conceptual perspectives on tactics and decision-making}},
  author = {Davi Correia da Silva and José Roberto Afonso and Thiago de Amorim Carvalho and Marco Abreu and Grégory Hallé Petiot and Fabrício Vieira Do Amaral Vasconcellos},
  year = {2026},
  doi = {10.1080/1612197x.2026.2764666},
  url = {https://doi.org/10.1080/1612197x.2026.2764666},
  keywords = {futbol, sistemas_complejos},
  note = {Trabajo conceptual publicado en IJSEP sobre periodización táctica como enfoque integrado de táctica y decisión en fútbol; análisis basado solo en el título.},
  journal = {International Journal of Sport and Exercise Psychology}
}

@article{latinjak2026the,
  title = {{The E³P model: perception of external events and exposures in sport and exercise}},
  author = {Alexander T. Latinjak},
  year = {2026},
  doi = {10.1080/1612197x.2026.2764659},
  url = {https://doi.org/10.1080/1612197x.2026.2764659},
  abstract = {Research on perception, attention, and appraisal in sport and exercise is extensive and influential. Building on this foundation, the Integrative External Events and Exposures Perception (E³P) model is introduced as a scaffold that connects established insights and clarifies implications for research and practice. The model conceptualises perception broadly as the conversion of external events into internal information. It frames the process in three components: (a) input, encompassing sensory energies and exogenous substances that, once taken up, generate perceivable internal signals; (b) attention allocation, conceived as a depth valve that routes processing along a shallow–to–deep continuum, alongside breadth, stability, and flexibility; and (c) a four-layer sequence of meaning-making—pre-attentive perception, stimulus-driven noticing, contextual interpretation, and evaluative appraisal—that operates cumulatively and concurrently. The model outlines multiple feed-forward and feedback loops within a perception–action cycle, together with continuous interactions with proprioception, internally directed attention, and self-regulation. The model components are mapped onto five applied approaches – game-based task design, technology-mediated simulations, sensory and physiological optimisation, cognitive–attentional training, and long-term personal development – to support athlete learning and development, elite performance, and inclusive practice across diverse participants. Overall, the E³P model offers an integrative account from input to appraisal, providing a shared language and research architecture for examining where perceptual-performance effects arise, how processes interact across the perception–action cycle, and when component-specific or coordinated interventi},
  keywords = {aprendizaje_talento},
  note = {Modelo conceptual que organiza la percepción en entrada, atención y cuatro capas de interpretación dentro del ciclo percepción-acción, con cinco vías aplicadas.},
  journal = {International Journal of Sport and Exercise Psychology}
}

@article{medernach2026expertise,
  title = {{“Expertise guides where attention lies”: exploring climbers’ attentional focus during route preview using eye-tracking and verbal reports}},
  author = {Jerry Prosper Medernach and Kevin Mangan and Nick Draper and Daniel Memmert and Julian Henz},
  year = {2026},
  doi = {10.1080/1612197x.2026.2757849},
  url = {https://doi.org/10.1080/1612197x.2026.2757849},
  abstract = {Route preview, the visual inspection of climbing movements prior to motor execution, has attracted scientific interest over the past decades. From a sport psychology perspective, elucidating factors underlying differences in attentional focus during route preview appears promising for advancing understanding of how expertise shapes attentional processes in climbing and other relatively closed sporting contexts. This study examined attentional focus during route preview across climbers of varying skill levels by analysing gaze behaviour using portable eye-tracking. Twenty-five intermediate, advanced, and elite climbers previewed and attempted an Olympic boulder problem. Data collection included gaze behaviour during route preview alongside concurrent think-aloud and retrospective verbal reports, as well as climbing performance metrics. Besides lower climbing performance, intermediate climbers showed longer preview and total absolute fixation durations at holds than advanced and elite climbers. Despite similar overall relative fixations, the spatial distribution of these fixations differed between the groups; advanced and elite climbers displayed a more homogeneous pattern with lower variability, allocating a greater proportion of fixations to the middle and final sections of the boulder, whereas intermediate climbers focused more on the starting section. Verbal reports similarly revealed skill-level differences in attentional distribution and factors shaping attentional focus toward task-relevant holds. Findings suggest that attentional focus during route preview reflects an interplay among cognitive processing of movement demands, task difficulty relative to skill level, and perceived task-relevant priorities. Accordingly, differences in gaze behaviour may reflect not o},
  keywords = {aprendizaje_talento},
  note = {Con 25 escaladores, los expertos distribuyen la mirada con menos variabilidad y menos tiempo por presa que los intermedios al previsualizar la ruta.},
  journal = {International Journal of Sport and Exercise Psychology}
}

@article{prietolage2026tactical,
  title = {{Tactical behaviour in elite U-12 boys’ tennis: an observational mixed methods case study of the Open Super 12 Auray tournament}},
  author = {Iván Prieto-Lage and Xoana Reguera-López-de-la-Osa and Juan Carlos Argibay-González and Alfonso Gutiérrez-Santiago},
  year = {2026},
  doi = {10.3389/fpsyg.2026.1951457},
  url = {https://doi.org/10.3389/fpsyg.2026.1951457},
  abstract = {Evidence on tactical behaviour in elite U-12 tennis remains limited, particularly regarding how the serve interacts with rally development and point outcome. This observational mixed methods case study used a quantitatively driven qual → QUAN → qual analytical sequence to characterise the tactical profile of elite international U-12 boys competing at the 2023 Open Super 12 Auray tournament. Spontaneous match behaviours were systematically observed, transformed into coded categorical data using the OBSTENNIS-JUNIOR-S23 observational instrument, analysed quantitatively, and subsequently interpreted within their competitive and developmental context. A total of 557 points from seven matches involving eight players were analysed. Descriptive statistics, chi-square tests, Cramér’s V, adjusted standardised residuals, and conditional winning probabilities were calculated. Point outcome was relatively balanced between server (46.7%) and receiver (53.3%). After excluding double faults, the server won 53.7% of first-serve points and 43.3% of second-serve points. Body serves predominated overall (59.4%) and were especially frequent on second serves (91.0%). Short rallies accounted for 53.1% of points, although rally length was not associated with point outcome. Unforced errors were the main route to point resolution. The integrated observational mixed methods approach enabled the construction of a contextualised tactical profile of elite U-12 boys’ tennis. These findings indicate that, in this competitive case, the serve did not provide a clear overall tactical advantage and support training approaches that combine serve-placement variability, serve–return–third-shot sequences, rally consistency, and error management.},
  keywords = {aprendizaje_talento},
  note = {Análisis de 557 puntos en tenis U-12 de élite: ventaja del saque limitada, predominio del saque al cuerpo y los errores no forzados como causa principal de cierre de punto.},
  journal = {Frontiers in Psychology}
}

