  note = {Libro de Routledge (©2026) editado por Araújo, Chow y Davids, presentado como el primero que aplica la investigación en dinámica ecológica al fútbol. Resumen basado en la ficha de la editorial; no he leído el libro.},
  publisher = {Routledge}
}

@article{serra2026defensive,
  title = {{Defensive synergies in association football: A systematic scoping review}},
  author = {Enrico Serra and Daniel Carrilho and Li Xiao and Silvia Coppola and Rodolfo Vastola and Duarte Araújo},
  year = {2026},
  doi = {10.1177/17479541261506867},
  url = {https://doi.org/10.1177/17479541261506867},
  abstract = {The evolution of performance analysis in association football, supported by positional tracking, has improved understanding of collective behaviour. However, matches, and the defensive phase, are often summarised through statistics or outcomes. These indicators are poorly sensitive to the emergent organisation of out-of-possession play. From an ecological dynamics perspective, defensive coordination consists of functional couplings between defenders that create synergies reorganising according to task constraints. This scoping review mapped evidence on intra-team defensive synergies in association football following JBI guidance and PRISMA-ScR, including studies published between 01/01/2000 and 01/09/2025 (English/Italian/Spanish/Portuguese/French) that operationalised intra-team defensive coordination and synergies (≥2 defenders). Searches in PubMed/MEDLINE, Scopus, Web of Science, SPORTDiscus, and APA PsycInfo yielded 1217 records; after removing 363 duplicates, 854 records underwent screening and 131 full texts were assessed, resulting in 63 included studies. Common data sources were optical tracking and GPS/GNSS, combined with video/event data. Explicit defensive outcomes were reported in 21/63 studies. Contextual constraints were considered in most studies. The literature is growing, but remains heterogeneous and links between collective properties and defensive outcomes are not systematic. Minimum reporting standards, a core set of metrics, and stronger alignment between coordination measures and process-based outcomes consistent with the out-of-possession phase are needed.},
  keywords = {sistemas_complejos, futbol, pedagogia_no_lineal},
  note = {Revisión de 63 estudios sobre sinergias defensivas en fútbol desde la dinámica ecológica. Muestra un campo en crecimiento pero heterogéneo, con pocos estudios que conecten la coordinación con resultados defensivos.},
  journal = {International Journal of Sports Science & Coaching}
}

@article{krampe2026dimensionality,
  title = {{Dimensionality reduction of space-related metrics in elite football using factor analysis}},
  author = {Lisa Krampe and Daniel Memmert and Maximilian Klemp},
  year = {2026},
  doi = {10.1080/02640414.2026.2763159},
  url = {https://doi.org/10.1080/02640414.2026.2763159},
  abstract = {Spatial organisation is fundamental to understanding football tactics and phase-dependent coordination. However, the high intercorrelation between existing spatial metrics suggests significant redundancy. This study aims to identify the latent dimensions of spatial positioning in- and out-of-possession to refine the theoretical framework of space in professional football. An open-source dataset comprising seven male German Bundesliga matches was utilised to analyse team length, width, height, surface area, convex hull, team centroid, team spread, stretch index, Delaunay triangulation and Voronoi diagram. Ball possession status served as the independent variable. Spearman's rank correlation coefficients were calculated, while data suitability was examined using the KMO statistic and Bartlett's test of sphericity. An exploratory factor analysis was performed to identify underlying latent constructs. High intercorrelation among spatial metrics justified factor analysis to reduce redundancy. The analysis reveals three consistent spatial dimensions that explain team organisation, regardless of possession status. These dimensions account for 77.1% and 75.5% of the variance, respectively, with the first dimension representing almost half of the variance in each case. Factor analysis reduces complex spatial data into three functional dimensions: 'team dispersion', 'longitudinal dispersion', and 'longitudinal positioning'. This facilitates a concise yet comprehensive interpretation of tactical structures and performance analysis.},
  keywords = {sistemas_complejos, futbol},
  note = {Reduce más de diez métricas espaciales de equipo a tres dimensiones con análisis factorial en la Bundesliga. Sugiere simplificar el análisis táctico sin perder información.},
  journal = {Journal of Sports Sciences}
}

@article{purwanto2026physical,
  title = {{Physical fitness changes following group-based interval small-sided games among middle school soccer players}},
  author = {Didik Purwanto and Ali Ismael Obaid and Maharani Fatima Gandasari and Dimas Duta Putra Utama and Zulpikar Ilham and Ratno Susanto and Dilli Dwi Kuswoyo},
  year = {2026},
  doi = {10.54899/iij.v20i4.1343},
  url = {https://doi.org/10.54899/iij.v20i4.1343},
  abstract = {Objective: This study examined changes in aerobic fitness, resting and exercise heart rates, and sprint performance following an eight-week interval-based small-sided games program among middle school students participating in extracurricular soccer. Methods: Twenty-four male students from SMP Negeri 6 Palu, Indonesia, participated in a one-group pretest–posttest study involving 24 training sessions. The intervention consisted of 4 vs. 4 small-sided games played on a 30 × 25 m pitch in four 4-min bouts, separated by 2 min of passive recovery. Aerobic fitness was assessed using the Yo-Yo Intermittent Recovery Test Level 1 and expressed as estimated maximal oxygen uptake (VO₂max). Heart rate was measured at rest and during exercise, while sprint performance was evaluated using a 30-m sprint test. Pretest and posttest measurements were compared using paired-samples t-tests. Results: Significant pre–post improvements were observed in estimated VO₂max, which increased from 49.82 ± 2.91 to 54.73 ± 3.08 mL·kg⁻¹·min⁻¹. Resting heart rate decreased from 72.13 ± 4.87 to 67.08 ± 4.12 beats·min⁻¹, while exercise heart rate decreased from 181.46 ± 6.35 to 174.21 ± 5.92 beats·min⁻¹. The 30-m sprint time also improved from 4.82 ± 0.31 to 4.56 ± 0.28 s. All observed differences were statistically significant (p < .001). Conclusion: A systematically structured interval-based small-sided games program was associated with improvements in aerobic fitness, heart-rate responses, and sprint performance among middle school soccer players. This approach may provide a practical and engaging conditioning strategy for school-based extracurricular soccer programs. Nevertheless, because the study employed a single-group design without a control condition, the findings represent pre–post changes and },
  keywords = {futbol, aprendizaje_talento},
  note = {Ocho semanas de 4v4 interválicos mejoraron el VO₂max estimado y el sprint en 24 jóvenes. Sin grupo control, se leen como cambios pre–post.},
  journal = {Interpersona An International Journal on Personal Relationships}
}

@article{silva2026effects,
  title = {{Effects of contextual factors on the external workload of top-up training sessions in an elite football team}},
  author = {Rodrigo Silva and Bruno Gonçalves and Eduardo Abade and Nuno Batalha and Hugo Folgado and Christian Castilla-López},
  year = {2026},
  doi = {10.1177/17479541261507323},
  url = {https://doi.org/10.1177/17479541261507323},
  abstract = {This study aimed to analyse how match location and match outcome affect the external load of top-up sessions in professional football. Forty elite male players from a Spanish first-division team were monitored across 31 top-up sessions during the 2023/2024 competitive season, yielding 628 player-session observations for match-location analyses and 369 player-session observations for match-outcome analyses after excluding drawn matches. External load metrics were obtained via GPS, including total distance, high-speed running (HSR), sprint distance, and the number of accelerations and decelerations. Separate linear mixed-effects models tested location (home/away) and outcome (win/loss), with player as a random effect. Away matches produced longer session duration (F (1, 332) = 15.4, p < .001) with no other differences. Following a loss, sessions showed longer duration (F (1, 197) = 31.4, p < .001), total distance (F (1, 173) = 4.5, p = .036), sprint distance (F (1, 179) = 10.6, p = .001), accelerations >3 m/s 2 (F (1, 174) = 19.4, p < .001), and decelerations >3 m/s 2 (F (1, 170) = 12.5, p < .001), with no differences in high-speed running distance. Marginal R 2 values were low, while conditional R 2 values were higher, reflecting substantial between-player variability. Top-up demands were consistently higher after losses, suggesting that these sessions may be sensitive to competitive context rather than reflecting a stable match replication stimulus. More standardised loading targets may support more consistent weekly load management in underplayed players.},
  keywords = {futbol},
  note = {En un equipo de élite, perder el partido aumenta la carga externa de la sesión de compensación. Hay mucha variabilidad individual.},
  journal = {International Journal of Sports Science & Coaching}
}

@article{harknessarmstrong2026you,
  title = {{“You sink or swim”: An investigation into the experiences of applied performance analysts working in women's football}},
  author = {Alice Harkness-Armstrong and Ruth Lowry and Abbie Jackson and Laura Seth and Naomi Datson},
  year = {2026},
  doi = {10.1177/17479541261507198},
  url = {https://doi.org/10.1177/17479541261507198},
  abstract = {Performance analysis research within football has focussed on the outputs of systematic observation, quantification and analysis of performance; less attention has been given to the applied practices of performance analysts. Therefore, this study aimed to investigate the experiences of applied performance analysts working within women's football, providing further insight beyond previous initial explorations. Ten performance analysts working with senior women's football teams (international n = 3; top-tier domestic n = 2; second-tier domestic n = 5) in the United Kingdom, participated in semi-structured interviews, which were analysed using reflexive thematic analysis. Two key themes were developed. Firstly, developing as an applied performance analyst in women's football, with four sub-themes of 1) alignment of learning opportunities to real-world practice, 2) preferences for learning opportunities, 3) navigating internal constraints and 4) navigating external constraints. Secondly, working as an applied performance analyst within women's football, with three sub-themes; 1) prioritisation of performance analysis provision, 2) implementing appropriate performance analysis provision and 3) challenges of working within women's football. The results demonstrate the breadth, depth and complexities of challenges and considerations in becoming, being and developing as an applied performance analyst within women's football. As such, the findings have wide-ranging implications for higher education institutions, academics, and development and learning professionals within football organisations and governing bodies, informing the development of aspiring and current analysts. The findings also have implications for applied performance analysts, clubs, organisations, and governing},
  keywords = {futbol},
  note = {Diez analistas describen cómo se forman y trabajan en fútbol femenino y las restricciones que encuentran.},
  journal = {International Journal of Sports Science & Coaching}
}

@article{bchini2026neuromuscular,
  title = {{Neuromuscular performance, physiological recovery, and maturation-referenced reference values in youth athletes: A cross-sectional study}},
  author = {Souhail Bchini and Dhouha Moussaoui and Anissa Bouassida and Nouf H. Alkhamees and Nadhir Hammami and Fatma Hilal Yagin},
  year = {2026},
  doi = {10.1371/journal.pone.0362757},
  url = {https://doi.org/10.1371/journal.pone.0362757},
  abstract = {This cross-sectional study characterized neuromuscular performance and acute physiological responses across age, sex, and biological maturation in 140 youth athletes (74 boys, 66 girls; 10–16 years), and described maturation-stratified distributions of two field measures. Participants completed 30-m sprint, countermovement jump (CMJ), standing long jump (SLJ), and handgrip testing; post-sprint heart-rate recovery (HRrec-30s) and a testing-battery perceived-exertion index (PEI) served as co-primary physiological/perceptual outcomes; maturity offset (Mirwald method) classified Pre-, Circa-, and Post-PHV subgroups; allometric scaling was used to account for body size; and a Benjamini–Hochberg false-discovery-rate correction was applied across a pre-specified family of 58 pairwise comparisons and correlations (Tables 2–6). Boys outperformed girls across all neuromuscular tests (d = 0.63–0.76), whereas HRrec-30s and the perceived-exertion index did not differ significantly by sex. HRrec-30s was more strongly associated with maturity offset than with chronological age (r = 0.52 vs 0.46; η²p for maturation vs age groups 0.43 vs 0.39). Mean HRrec-30s was 27.8 ± 6.2 bpm in the Pre-PHV group and 45.3 ± 8.8 bpm in the Post-PHV group (p < 0.001, FDR-corrected). The perceived-exertion index was lower in more mature groups (7.5 ± 1.2 vs 6.3 ± 1.1). Sex and maturation differences in jump and strength performance remained after allometric scaling, although they were smaller. Maturation-stratified distributions reported here are preliminary and descriptive and are not decision thresholds; prospective, criterion-validated research is needed before they can be recommended for individual athlete monitoring or training-load decision-making.},
  keywords = {aprendizaje_talento},
  note = {Datos de 140 jóvenes muestran que la maduración explica la recuperación cardiaca mejor que la edad. Referencias preliminares.},
  journal = {PLOS ONE}
}

@article{jurak2026generational,
  title = {{Generational change in Slovenian youth sport participation}},
  author = {Gregor Jurak and Nikola Todorović and Bojan Leskošek and Gregor Starc},
  year = {2026},
  doi = {10.3389/fspor.2026.1969041},
  url = {https://doi.org/10.3389/fspor.2026.1969041},
  abstract = {Background Organised sport participation during adolescence provides important physical, psychosocial, and developmental benefits, yet long-term secular trends remain insufficiently understood. This study examined decade-long changes in organised sport participation among Slovenian adolescents using nationally representative repeated cross-sectional data from the Analysis of Children's Development in Slovenia (ACDSi). Methods Data included 5,027 adolescents aged 11–18 years assessed in 2013–2014 and 2023–2024. Organised sport participation, participation history, weekly training volume, sport-category distribution, and physical fitness were analysed overall and by sex and ISCED level. Between-wave differences were tested using Pearson's chi-square tests, and training volume and fitness outcomes using general linear models. Results Organised sport participation increased from 50.4% to 63.4% ( P &lt; .001; OR = 1.71, 95% CI 1.52–1.91), with increases observed in both sexes and both ISCED levels. In the complete-case analysis, previous participation followed by discontinuation was more common in 2023–2024 than in 2013–2014 (27.1% vs. 19.7%), although participation-history data were incomplete for a substantial proportion of 2013–2014 non-participants. Among current participants, adjusted weekly training volume increased from 4.26 to 4.99 h/week in ISCED 2 and from 4.71 to 5.30 h/week in ISCED 3. Sport-category distribution changed modestly across the decade, particularly among girls, while team sports remained the dominant category. Physical fitness differed slightly across sport categories, with the clearest differences observed for standing long-jump and 60-m sprint performance. Conclusions Organised sport engagement among Slovenian adolescents increased over the past de},
  keywords = {aprendizaje_talento},
  note = {La práctica deportiva organizada de adolescentes eslovenos aumentó de 50 % a 63 % en diez años, con más abandonos entre quienes empezaron.},
  journal = {Frontiers in Sports and Active Living}
}

@article{ojedaaravena2026from,
  title = {{From sport-specific testing to competitive behavior in combat sports: matching designs to inferential questions}},
  author = {Alex Ojeda-Aravena},
  year = {2026},
  doi = {10.3389/fphys.2026.2005041},
  url = {https://doi.org/10.3389/fphys.2026.2005041},
  abstract = {Sport-specific tests have improved the assessment of physical capacities in combat sports, but technical resemblance does not establish how a capacity is used against an opponent. This Perspective clarifies the evidence required to connect standardized measurement with predefined behavior under opposition. It distinguishes four related inferential questions concerning measurement, competitive association, contribution to competitive behavior, and transfer. The third question asks whether, and under which constraints, a measured capacity helps produce or regulate a predefined behavior during interaction with an opponent. These questions require different evidence without forming compulsory sequential stages or a uniform hierarchy of causal attribution. Drawing on measurement theory, representative design, and ecological dynamics, the argument follows kicking speed in taekwondo and grip strength in judo, supported by examples from other combat disciplines. It distinguishes integrated task performance from isolated capacities, capacity magnitude from individual use, and behavior from effectiveness and competitive success. Constrained opponent tasks can test whether capacity–behavior relationships vary with theoretically relevant constraints, but such interactions do not independently identify causal mechanisms. Longitudinal changes may be consistent with transfer while remaining compatible with familiarization, technical learning, or other intervention components. Standardized tests, opponent tasks, simulated bouts, and competition may therefore provide complementary evidence when the construct, behavioral criterion, opposition, and permissible inference are specified prospectively. Further progress may depend on both adequate measurement and studies linking capacities to },
  keywords = {pedagogia_no_lineal, sistemas_complejos},
  note = {Perspectiva que distingue cuatro preguntas inferenciales para pasar de los tests específicos a la conducta competitiva con oponente. Defiende especificar de antemano constructo, criterio y oposición, y no atribuir causalidad solo por una interacción capacidad×restricción.},
  journal = {Frontiers in Physiology}
}

@article{felipe2026playing,
  title = {{Playing Surface Characteristics and Their Effects on Football Performance Across Multiple Surface Types: A Systematic Review}},
  author = {Jose Luis Felipe and Antonio Hernández-Martín and Enrique Colino and Katie Mills and Mickael Benetti and Johsan Billingham and Leonor Gallardo and Jorge García‐Unanue},
  year = {2026},
  doi = {10.1186/s40798-026-01117-7},
  url = {https://doi.org/10.1186/s40798-026-01117-7},
  abstract = {The characteristics of the playing surface are increasingly recognized as key determinants of football-specific performance. This systematic review synthesizes mechanistic and applied evidence on how natural grass, artificial turf, and sand influence physical, physiological, neuromuscular, and perceptual outcomes in football players. Following PRISMA guidelines, a systematic search of PubMed, SPORTDiscus and Web of Science was conducted from database inception to 17 June 2026. Eligible studies included original peer-reviewed research involving football players performing football-related activities on natural grass, artificial turf, or other playing surfaces, provided that natural grass or artificial turf was included as a comparison condition. Risk of bias was assessed using the ROBINS-I tool for non-randomized intervention studies and the Newcastle–Ottawa Scale adapted for cross-sectional studies (NOS-xs). Results were synthesized using a qualitative narrative approach because of substantial methodological heterogeneity across study designs, surface comparisons, and outcome measures. A total of 814 records were identified, of which 16 studies met the eligibility criteria. Locomotor responses were the most surface-sensitive domain: several studies reported greater external running demands on artificial turf, including higher sprint frequency, acceleration demands, and total running distance; however, results were heterogeneous and some studies observed no meaningful differences between surfaces. Sand consistently imposed greater metabolic cost and reduced running efficiency. Physiological responses (e.g., heart rate and lactate) showed variable results across studies, suggesting that internal load may be influenced not only by surface characteristics but also by task c},
  keywords = {futbol},
  note = {Revisión sistemática de 16 estudios sobre el efecto de la superficie de juego en el rendimiento futbolístico. Las demandas locomotoras cambian con el césped artificial y la arena aumenta el coste metabólico, con resultados heterogéneos.},
  journal = {Sports Medicine - Open}
}

@misc{lopez2026the,
  title = {{The play that never happened: validating a counterfactual football simulator without ground truth}},
  author = {José María García de Marina López},
  year = {2026},
  doi = {10.51224/SportRxiv.1167},
  url = {https://sportrxiv.org/index.php/server/preprint/view/1167},
  abstract = {Section: Preprints Categories: Sport Science Keywords: football, tracking data, counterfactual simulation, model validation, pre-registration, decision models, multi-agent trajectories Counterfactual questions are the ones coaches ask most, and the hardest to validate: the alternative play never happened, so there is nothing to score it against. We present PlayLab, an interactive simulator that takes any real moment of a football match from broadcast tracking data, lets the user change it, and plays the next 20 s forward in a browser at 10 Hz. It is assembled from small, separately fitted components (defensive and attacking movement, pressing, goalkeeping, pass flight and completion, option listing, two decision policies, shooting and ball loss), fitted on the Saudi Pro League with SkillCorner tracking. We propose a three-layer validation protocol for simulators without counterfactual ground truth: component replay on held-out matches, stepped as the simulator steps them; decision-outcome evaluation on 59,972 real passes; and distributional plausibility of free-running chains on banks of real starting moments, with every change accepted or rejected by pre-registered pass marks. A learned defensive step model reduces the stepped 5 s error of hand-written rules from 5.94 to 5.28 m on 92 held-out matches, a network cuts a further 9.4%, and the defence ends 38% closer to real defenders than a player who stands still; off-ball attackers improve from 5.37 to 5.10 m and win in all 94 held-out matches at 3 s. The protocol also found a fault no component test showed: a value-maximising decision rule that was accurate on single real decisions switched play three times more often than the league once chained, because its value ignored the defensive reaction the simulation then app},
  keywords = {futbol, sistemas_complejos},
  note = {Preprint que presenta un simulador de jugadas de fútbol con tracking y un protocolo de validación en tres capas. Muestra que decisiones buenas por separado producen patrones irreales al encadenarse, porque ignoran la reacción del rival.},
  howpublished = {SportRxiv}
}

